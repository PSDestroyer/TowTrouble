    m_Localized: "Board \u0110\xE3 ho\xE0n th\xE0nh tab"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535355
    m_Localized: "Ch\u01B0a ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9
      n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535356
    m_Localized: "\u0110\xE3 ho\xE0n th\xE0nh m\u1ECDi nhi\u1EC7m v\u1EE5 c\u1EE9u
      h\u1ED9. Ch\u01A1i l\u1EA1i trong m\u1EE5c \u0110\xE3 ho\xE0n th\xE0nh."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535357
    m_Localized: "C\u1EE9u h\u1ED9 details"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535358
    m_Localized: "\u0110\u1ECBa h\xECnh "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535359
    m_Localized: "Khuy\xEAn d\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535360
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535361
    m_Localized: "Ch\u01A1i l\u1EA1i \xB7 Ph\u1EA7n th\u01B0\u1EDFng"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535362
    m_Localized: " min  \xB7  "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535363
    m_Localized: "C\u1EE9u h\u1ED9 l\u1EA7n \u0111\u1EA7u +25% \xB7 "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535364
    m_Localized: "Ch\u01A1i l\u1EA1i  "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535365
    m_Localized: "Kh\xF4ng \u0111\u1EB7t l\u1EA1i +10% \xB7 Kh\xF4ng \u0111\u1EE9t
      c\xE1p +10%"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535366
    m_Localized: "Nhi\u1EC7m v\u1EE5 \u0111\xE3 xong xu\u1EA5t hi\u1EC7n t\u1EA1i
      \u0111\xE2y \u0111\u1EC3 ch\u01A1i l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535367
    m_Localized: "Ch\u01A1i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535368
    m_Localized: " \u0110\xE3 ho\xE0n th\xE0nh"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535369
    m_Localized: " Kh\u1EA3 d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535370
    m_Localized: "\u0110ang th\u1EF1c hi\u1EC7n "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535371
    m_Localized: "Kh\xF4ng c\xF3 nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9 \u0111ang di\u1EC5n
      ra. Ch\u1ECDn n\u01A1i \u0111\u1EBFn ti\u1EBFp theo."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535372
    m_Localized: "B\u1ECF nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535373
    m_Localized: "Nh\u1EADn nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535374
    m_Localized: "Ch\u1EE7 ph\xF2ng ch\u1ECDn nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9
      cho \u0111\u1ED9i."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535375
    m_Localized: "C\u1EE9u h\u1ED9 photo"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535376
    m_Localized: "C\u1EA7n tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535377
    m_Localized: "Ph\u1EA3i stick"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535378
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535379
    m_Localized: "T\xF9y ch\u1ECDn \xE2m thanh v\xE0 \u0111i\u1EC1u khi\u1EC3n \u0111\u01B0\u1EE3c
      l\u01B0u t\u1EF1 \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535380
    m_Localized: "T\xF9y ch\u1ECDn \xE2m thanh v\xE0 \u0111i\u1EC1u khi\u1EC3n \u0111\u01B0\u1EE3c
      l\u01B0u t\u1EF1 \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535381
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535382
    m_Localized: "Tr\u1EE3 n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535383
    m_Localized: "Tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535384
    m_Localized: "Hi\u1EC3n th\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535385
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh cho tho\u1EA3i m\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535386
    m_Localized: "\xC2m l\u01B0\u1EE3ng t\u1ED5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535387
    m_Localized: "Hi\u1EC7u \u1EE9ng xe v\xE0 c\u1EE9u h\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535388
    m_Localized: "Nh\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535389
    m_Localized: "M\xF4i tr\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535390
    m_Localized: "Giao di\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535391
    m_Localized: "\u0110\u1ED9 s\xE1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535392
    m_Localized: "Ch\u1EA5t l\u01B0\u1EE3ng "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535393
    m_Localized: "Hi\u1EC7u n\u0103ng gi\u1EA3m chi ti\u1EBFt. Ch\u1EA5t l\u01B0\u1EE3ng
      gi\u1EEF nhi\u1EC1u chi ti\u1EBFt h\u01A1n. \xC1p d\u1EE5ng \u0111\u1EC3 xem
      th\u1EED."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535394
    m_Localized: "To\xE0n m\xE0n h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535395
    m_Localized: "C\u1EEDa s\u1ED5"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535396
    m_Localized: "Gi\u1EEF c\xE0i \u0111\u1EB7t hi\u1EC3n th\u1ECB? N\u1EBFu kh\xF4ng
      x\xE1c nh\u1EADn, c\xE0i \u0111\u1EB7t s\u1EBD tr\u1EDF l\u1EA1i sau 15 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535397
    m_Localized: "\u0110\u1ED9 ph\xE2n gi\u1EA3i "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535398
    m_Localized: "Gi\u1EEF c\xE0i \u0111\u1EB7t hi\u1EC3n th\u1ECB? N\u1EBFu kh\xF4ng
      x\xE1c nh\u1EADn, c\xE0i \u0111\u1EB7t s\u1EBD tr\u1EDF l\u1EA1i sau 15 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535399
    m_Localized: "K\xEDch th\u01B0\u1EDBc hi\u1EC3n th\u1ECB theo m\xE1y ch\u01A1i
      game."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535400
    m_Localized: "\xC1p d\u1EE5ng thay \u0111\u1ED5i hi\u1EC3n th\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535401
    m_Localized: " \u0110i\u1EC1u khi\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535402
    m_Localized: "Nh\u1EA5n m\u1ED9t ph\xEDm. Esc \u0111\u1EC3 h\u1EE7y."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535403
    m_Localized: "Ch\u1ECDn thao t\xE1c \u0111\u1EC3 \u0111\u1ED5i ph\xEDm. M\u1ED7i
      ph\xEDm ch\u1EC9 \u0111\u01B0\u1EE3c g\xE1n m\u1ED9t thao t\xE1c. "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535404
    m_Localized: "Ch\u1ECDn thao t\xE1c \u0111\u1EC3 \u0111\u1ED5i ph\xEDm. M\u1ED7i
      ph\xEDm ch\u1EC9 \u0111\u01B0\u1EE3c g\xE1n m\u1ED9t thao t\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535405
    m_Localized: "\u0110\u1EA3o tr\u1EE5c Y m\xE1y quay "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535406
    m_Localized: "\u0110\u1EA3o chi\u1EC1u chuy\u1EC3n \u0111\u1ED9ng d\u1ECDc c\u1EE7a
      m\xE1y quay."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535407
    m_Localized: "\u0110\u1ED9 nh\u1EA1y m\xE1y quay"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535408
    m_Localized: "C\u1EE1 ch\u1EEF / HUD"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535409
    m_Localized: "Gi\u1EA3m chuy\u1EC3n \u0111\u1ED9ng "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535410
    m_Localized: "Gi\u1EA3m chuy\u1EC3n \u0111\u1ED9ng m\xE1y quay v\xE0 menu \u0111\u1EC3
      d\u1EC5 ch\u1ECBu h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535411
    m_Localized: "K\xFD hi\u1EC7u \u0111\u1ED9 c\u0103ng "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535412
    m_Localized: "Hi\u1EC3n th\u1ECB bi\u1EC3u t\u01B0\u1EE3ng c\xF9ng m\xE0u s\u1EAFc
      cho \u0111\u1ED9 c\u0103ng c\xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535413
    m_Localized: "G\u1EE3i \xFD h\u01B0\u1EDBng d\u1EABn "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535414
    m_Localized: "Hi\u1EC3n th\u1ECB g\u1EE3i \xFD theo t\xECnh hu\u1ED1ng. M\u1EE5c
      ti\xEAu v\xE0 c\u1EA3nh b\xE1o c\xE1p v\u1EABn hi\u1EC3n th\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535415
    m_Localized: "Rung tay c\u1EA7m "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535416
    m_Localized: "Ph\u1EA3n h\u1ED3i nh\u1EB9 cho c\xE1p, t\u1EDDi, va ch\u1EA1m
      v\xE0 c\u1EE9u h\u1ED9. C\xF3 th\u1EC3 t\u1EAFt b\u1EA5t c\u1EE9 l\xFAc n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535417
    m_Localized: "C\u01B0\u1EDDng \u0111\u1ED9 rung"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535418
    m_Localized: "C\xE1ch ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535419
    m_Localized: "T\u1EADp l\xE1i, n\u1ED1i c\xE1p, d\xF9ng t\u1EDDi v\xE0 b\xE0n
      giao. S\u1EF1 nghi\u1EC7p c\u1EE7a b\u1EA1n kh\xF4ng b\u1ECB \u1EA3nh h\u01B0\u1EDFng."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535420
    m_Localized: "\u0110\u1EB7t l\u1EA1i ti\u1EBFn tr\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535421
    m_Localized: "\u0110\u1EB7t l\u1EA1i to\xE0n b\u1ED9 ti\u1EBFn tr\xECnh? Ti\u1EC1n,
      xe, trang b\u1ECB v\xE0 c\u1EA5u h\xECnh \u0111\xE3 l\u01B0u s\u1EBD b\u1ECB
      x\xF3a. T\xF9y ch\u1ECDn \u0111\u01B0\u1EE3c gi\u1EEF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535422
    m_Localized: "\u0110\u1EB7t l\u1EA1i to\xE0n b\u1ED9 ti\u1EBFn tr\xECnh? Ti\u1EC1n,
      xe, trang b\u1ECB v\xE0 c\u1EA5u h\xECnh \u0111\xE3 l\u01B0u s\u1EBD b\u1ECB
      x\xF3a. T\xF9y ch\u1ECDn \u0111\u01B0\u1EE3c gi\u1EEF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535423
    m_Localized: "R\u1EDDi phi\xEAn ch\u01A1i tr\u01B0\u1EDBc khi \u0111\u1EB7t l\u1EA1i
      ti\u1EBFn tr\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535424
    m_Localized: "Kh\xF4i ph\u1EE5c th\u1EBB n\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535425
    m_Localized: "Kh\xF4i ph\u1EE5c m\u1EB7c \u0111\u1ECBnh "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535426
    m_Localized: " Kh\xF4i ph\u1EE5c m\u1EB7c \u0111\u1ECBnh cho th\u1EBB n\xE0y?
      Ti\u1EBFn tr\xECnh s\u1EF1 nghi\u1EC7p \u0111\u01B0\u1EE3c gi\u1EEF nguy\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535427
    m_Localized: "Kh\xF4i ph\u1EE5c m\u1EB7c \u0111\u1ECBnh"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535428
    m_Localized: "Th\u1EBB tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535429
    m_Localized: "Th\u1EBB sau"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535430
    m_Localized: TOW TROUBLE
    m_Metadata:
      m_Items: []
  - m_Id: 4717535431
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 \u0111\u1ED5i c\xE1c c\xE0i \u0111\u1EB7t
      n\xE0y sau."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535432
    m_Localized: "\u0110i\u1EC1u ch\u1EC9nh cho tho\u1EA3i m\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535433
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 \u0111\u1ED5i c\xE1c c\xE0i \u0111\u1EB7t
      n\xE0y sau."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535434
    m_Localized: "Ch\u1ECDn chi\u1EBFc xe \u0111\u1EA7u ti\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535435
    m_Localized: "Ch\u1EC9nh ri\xEAng t\u1EEBng m\u1EE9c \xE2m l\u01B0\u1EE3ng. C\u1EA3nh
      b\xE1o h\xECnh \u1EA3nh v\u1EABn hi\u1EC3n th\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535436
    m_Localized: "\u0110\u1ED3 h\u1ECDa \u0111\u01B0\u1EE3c t\u1EF1 \u0111\u1ED9ng
      \u0111i\u1EC1u ch\u1EC9nh cho m\xE1y ch\u01A1i game n\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535437
    m_Localized: "Gi\u1EEF c\xE0i \u0111\u1EB7t hi\u1EC3n th\u1ECB? N\u1EBFu kh\xF4ng
      x\xE1c nh\u1EADn, c\xE0i \u0111\u1EB7t s\u1EBD tr\u1EDF l\u1EA1i sau 15 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535438
    m_Localized: "K\u1EBFt n\u1ED1i tay c\u1EA7m \u0111\u1EC3 xem c\xE1ch \u0111i\u1EC1u
      khi\u1EC3n. V\u1EABn c\xF3 th\u1EC3 d\xF9ng b\xE0n ph\xEDm v\xE0 chu\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535439
    m_Localized: "Ch\u1ECDn thao t\xE1c \u0111\u1EC3 \u0111\u1ED5i ph\xEDm. M\u1ED7i
      ph\xEDm ch\u1EC9 \u0111\u01B0\u1EE3c g\xE1n m\u1ED9t thao t\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535440
    m_Localized: "C\xF3 th\u1EC3 thay \u0111\u1ED5i c\u1EE1 ch\u1EEF v\xE0 \u0111\u1ED9
      nh\u1EA1y m\xE1y quay b\u1EA5t c\u1EE9 l\xFAc n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535441
    m_Localized: "G\u1EE3i \xFD gi\xFAp b\u1EA1n h\u1ECDc c\xE1ch ch\u01A1i. \u0110\u1EB7t
      l\u1EA1i ti\u1EBFn tr\xECnh x\xF3a s\u1EF1 nghi\u1EC7p v\xE0 gi\u1EEF t\xF9y
      ch\u1ECDn."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535442
    m_Localized: "B\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535443
    m_Localized: "T\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535444
    m_Localized: " \xB7 T\u0103ng t\u1ED1c / L\xF9i\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535445
    m_Localized: " \xB7 \u0110\xE1nh l\xE1i\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535446
    m_Localized: " \xB7 C\xE1p\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535447
    m_Localized: " \xB7 Phanh\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535448
    m_Localized: " \xB7 Thu c\xE1p / Nh\u1EA3 c\xE1p\nRMB \xB7 M\xE1y quay\nC \xB7
      \u0110\u1EB7t l\u1EA1i m\xE1y quay\n"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535449
    m_Localized: " \xB7 Ga-ra\n"
    m_Metadata:
