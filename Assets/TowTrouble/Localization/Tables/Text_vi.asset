      m_Items: []
  - m_Id: 3520848715779
    m_Localized: "To\xE0n m\xE0n h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715780
    m_Localized: "C\u1EEDa s\u1ED5"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715781
    m_Localized: "C\u1EA3nh b\xE1o"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715782
    m_Localized: "Luy\u1EC7n t\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715783
    m_Localized: "\u0110\u1EA3o tr\u1EE5c Y m\xE1y quay"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715784
    m_Localized: "C\u1EE9u h\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715785
    m_Localized: "\u0110a d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715786
    m_Localized: "B\u1EA3n r\u1ED9ng cho c\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715787
    m_Localized: "M\xF9a \u0111\xF4ng c\xF3 \u0111inh"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715788
    m_Localized: "V\xF9ng n\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715789
    m_Localized: "L\u1EF1c c\u1EA3n b\xF9n"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715790
    m_Localized: "Kho\u1EA3ng s\xE1ng g\u1EA7m"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715791
    m_Localized: "Ti\u1EC1n th\u01B0\u1EDFng"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715792
    m_Localized: "Xe c\u1EE7a b\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715793
    m_Localized: "Ch\u1ECDn"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715794
    m_Localized: "So s\xE1nh xe"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715795
    m_Localized: "Mua v\xE0 l\u1EAFp"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715796
    m_Localized: "Ho\xE0n th\xE0nh luy\u1EC7n t\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715797
    m_Localized: "B\u1EAFt \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715798
    m_Localized: "\u0110\xE3 m\u1EDF kh\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715799
    m_Localized: "\u0110\xE3 kh\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715800
    m_Localized: "\u0110\u1ED9i"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715801
    m_Localized: "Ch\u1EE7 ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715802
    m_Localized: Tham gia
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490410
    m_Localized: "Ch\u1ECDn nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9, chu\u1EA9n b\u1ECB
      xe v\xE0 \u0111\u01B0a xe g\u1EB7p n\u1EA1n \u0111\u1EBFn \u0111i\u1EC3m b\xE0n
      giao."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490411
    m_Localized: "L\xE1i nh\u1EB9 nh\xE0ng. K\xE9o \u0111\u1EC1u v\xE0 tr\xE1nh gi\u1EADt
      c\xE1p \u0111\u1ED9t ng\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490412
    m_Localized: "D\u1ECDn c\xE2y \u0111\u1ED5 tr\u01B0\u1EDBc khi c\u1EE9u h\u1ED9
      xe."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490413
    m_Localized: "D\xF9ng n\u1EC1n \u0111\u1EA5t ch\u1EAFc v\xE0 t\u1EDDi \u0111\u1EC3
      gi\u1EA3i c\u1EE9u xe."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490414
    m_Localized: "K\xE9o xe \u0111\xE3 \u0111\u01B0\u1EE3c gi\u1EA3i c\u1EE9u \u0111\u1EBFn
      \u0111i\u1EC3m b\xE0n giao c\xF3 \u0111\xE1nh d\u1EA5u v\xE0 d\u1EEBng b\xEAn
      trong."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490415
    m_Localized: "Xem th\u1EED ph\u1EE5 t\xF9ng tr\u01B0\u1EDBc khi mua. C\xF3 th\u1EC3
      l\u1EAFp mi\u1EC5n ph\xED ph\u1EE5 t\xF9ng \u0111\xE3 s\u1EDF h\u1EEFu."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490416
    m_Localized: "Ch\u1ECDn mi\u1EC5n ph\xED m\u1ED9t xe kh\u1EDFi \u0111\u1EA7u.
      Mua c\xE1c xe kh\xE1c t\u1EA1i x\u01B0\u1EDFng sau."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490417
    m_Localized: "T\xF9y ch\u1ECDn \xE2m thanh v\xE0 \u0111i\u1EC1u khi\u1EC3n \u0111\u01B0\u1EE3c
      l\u01B0u t\u1EF1 \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490418
    m_Localized: "Ch\u1EC9nh ri\xEAng t\u1EEBng m\u1EE9c \xE2m l\u01B0\u1EE3ng. C\u1EA3nh
      b\xE1o h\xECnh \u1EA3nh v\u1EABn hi\u1EC3n th\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490419
    m_Localized: "Ch\u1ECDn thao t\xE1c \u0111\u1EC3 \u0111\u1ED5i ph\xEDm. M\u1ED7i
      ph\xEDm ch\u1EC9 \u0111\u01B0\u1EE3c g\xE1n m\u1ED9t thao t\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490420
    m_Localized: "K\u1EBFt n\u1ED1i tay c\u1EA7m \u0111\u1EC3 xem c\xE1ch \u0111i\u1EC1u
      khi\u1EC3n. V\u1EABn c\xF3 th\u1EC3 d\xF9ng b\xE0n ph\xEDm v\xE0 chu\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490421
    m_Localized: "Gi\u1EA3m chuy\u1EC3n \u0111\u1ED9ng m\xE1y quay v\xE0 menu \u0111\u1EC3
      d\u1EC5 ch\u1ECBu h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490422
    m_Localized: "Hi\u1EC3n th\u1ECB bi\u1EC3u t\u01B0\u1EE3ng c\xF9ng m\xE0u s\u1EAFc
      cho \u0111\u1ED9 c\u0103ng c\xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490423
    m_Localized: "C\xF3 th\u1EC3 thay \u0111\u1ED5i c\u1EE1 ch\u1EEF v\xE0 \u0111\u1ED9
      nh\u1EA1y m\xE1y quay b\u1EA5t c\u1EE9 l\xFAc n\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490424
    m_Localized: "Kh\xF4i ph\u1EE5c m\u1EB7c \u0111\u1ECBnh cho th\u1EBB n\xE0y?
      Ti\u1EBFn tr\xECnh s\u1EF1 nghi\u1EC7p \u0111\u01B0\u1EE3c gi\u1EEF nguy\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490425
    m_Localized: "\u0110\u1EB7t l\u1EA1i to\xE0n b\u1ED9 ti\u1EBFn tr\xECnh? Ti\u1EC1n,
      xe, trang b\u1ECB v\xE0 c\u1EA5u h\xECnh \u0111\xE3 l\u01B0u s\u1EBD b\u1ECB
      x\xF3a. T\xF9y ch\u1ECDn \u0111\u01B0\u1EE3c gi\u1EEF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490426
    m_Localized: "R\u1EDDi phi\xEAn ch\u01A1i tr\u01B0\u1EDBc khi \u0111\u1EB7t l\u1EA1i
      ti\u1EBFn tr\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490427
    m_Localized: "Gi\u1EEF c\xE0i \u0111\u1EB7t hi\u1EC3n th\u1ECB? N\u1EBFu kh\xF4ng
      x\xE1c nh\u1EADn, c\xE0i \u0111\u1EB7t s\u1EBD tr\u1EDF l\u1EA1i sau 15 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490428
    m_Localized: "C\xE1c ph\u1EE5 t\xF9ng n\xE0y kh\xF4ng v\u1EEBa th\xE2n xe m\u1EDBi.
      Ch\xFAng v\u1EABn n\u1EB1m trong kho."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490429
    m_Localized: "B\xE1n ph\u1EE5 t\xF9ng n\xE0y? B\u1EA1n ph\u1EA3i mua l\u1EA1i
      n\u1EBFu mu\u1ED1n d\xF9ng ti\u1EBFp."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490430
    m_Localized: "L\u01B0u trang b\u1ECB \u0111ang l\u1EAFp. Ph\u1EE5 t\xF9ng \u0111ang
      xem th\u1EED kh\xF4ng \u0111\u01B0\u1EE3c l\u01B0u."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490431
    m_Localized: "Thay c\u1EA5u h\xECnh \u0111\xE3 l\u01B0u n\xE0y b\u1EB1ng trang
      b\u1ECB \u0111ang l\u1EAFp?"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490432
    m_Localized: "T\u1EADp l\xE1i, n\u1ED1i c\xE1p, d\xF9ng t\u1EDDi v\xE0 b\xE0n
      giao. S\u1EF1 nghi\u1EC7p c\u1EE7a b\u1EA1n kh\xF4ng b\u1ECB \u1EA3nh h\u01B0\u1EDFng."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490433
    m_Localized: "C\xF3 th\u1EC3 b\u1ECF qua b\xE0i t\u1EADp v\xE0 ch\u01A1i l\u1EA1i
      t\u1EEB C\xE1ch ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490434
    m_Localized: "Ch\u1EE7 ph\xF2ng ch\u1ECDn nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9
      cho \u0111\u1ED9i."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490435
    m_Localized: "Chia s\u1EBB \u0111\u1ECBa ch\u1EC9 IP n\u1ED9i b\u1ED9 c\u1EE7a
      ch\u1EE7 ph\xF2ng \u0111\u1EC3 ch\u01A1i c\xF9ng nhau."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490436
    m_Localized: "\u0110ang b\u1EAFt \u0111\u1EA7u tr\xF2 ch\u01A1i. Vui l\xF2ng
      ch\u1EDD."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490437
    m_Localized: "Kh\xF4ng th\u1EC3 b\u1EAFt \u0111\u1EA7u tr\xF2 ch\u01A1i. H\xE3y
      v\u1EC1 menu v\xE0 th\u1EED l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490438
    m_Localized: "R\u1EDDi nhi\u1EC7m v\u1EE5 n\xE0y m\xE0 kh\xF4ng nh\u1EADn ti\u1EC1n
      c\xF4ng? Trang b\u1ECB \u0111\xE3 mua v\xE0 ti\u1EC1n ki\u1EBFm \u0111\u01B0\u1EE3c
      v\u1EABn \u0111\u01B0\u1EE3c gi\u1EEF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490439
    m_Localized: "D\xF9ng l\u1ED1p ph\xF9 h\u1EE3p, l\u1EF1c k\xE9o \u0111\u1EE7
      m\u1EA1nh v\xE0 c\xE1p ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490440
    m_Localized: "Xe n\u1EB7ng h\u01A1n gi\xFAp neo gi\u1EEF t\u1ED1t h\u01A1n nh\u01B0ng
      kh\xF3 k\xE9o l\xEAn d\u1ED1c h\u01A1n."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490441
    m_Localized: "M\u1EDF gara khi d\u1EEBng g\u1EA7n x\u01B0\u1EDFng."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490442
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 \u0111\u1ED5i c\xE1c c\xE0i \u0111\u1EB7t
      n\xE0y sau."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490443
    m_Localized: "Trang b\u1ECB s\u1EF1 nghi\u1EC7p \u0111\xE3 \u0111\u01B0\u1EE3c
      kh\xF4i ph\u1EE5c. Ch\u1ECDn nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9 khi s\u1EB5n
      s\xE0ng."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490444
    m_Localized: "D\xF9ng t\u1EDDi nh\u1EB9 nh\xE0ng v\xE0 gi\u1EEF c\xE1p th\u1EB3ng
      theo l\u1ED1i ra."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490445
    m_Localized: "M\u1ED9t b\xE1nh xe m\u1EAFc trong r\xE3nh. K\xE9o \u0111\u1EC1u
      v\u1EC1 ph\xEDa \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490446
    m_Localized: "G\u1EA7m xe m\u1EAFc trong b\xF9n. K\xE9o t\u1EEB n\u1EC1n \u0111\u1EA5t
      ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490447
    m_Localized: "Xe b\u1ECB ng\u1EADp m\u1ED9t ph\u1EA7n. K\xE9o v\u1EC1 ph\xEDa
      b\u1EDD kh\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490448
    m_Localized: "Xe tr\u01B0\u1EE3t xu\u1ED1ng d\u01B0\u1EDBi \u0111\u01B0\u1EDDng.
      K\xE9o l\xEAn d\u1ED1c theo l\u1ED1i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490449
    m_Localized: "Tuy\u1EBFt ho\u1EB7c b\u0103ng gi\u1EEF ch\u1EB7t b\xE1nh xe. K\xE9o
      theo v\u1EC7t b\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490450
    m_Localized: "B\xE1nh xe b\u1ECB v\xF9i trong c\xE1t. K\xE9o t\u1EEB n\u1EC1n
      \u0111\u1EA5t ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490451
    m_Localized: "\u0110\u1ED9ng c\u01A1 ho\u1EB7c phanh b\u1ECB h\u1ECFng. Nh\u1EB9
      nh\xE0ng gi\u1EA3i c\u1EE9u xe r\u1ED3i k\xE9o \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490452
    m_Localized: "Xe m\u1EAFc trong l\xF2ng su\u1ED1i c\u1EA1n. D\xF9ng d\u1ED1c
      tho\xE1t ra."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490453
    m_Localized: "C\u1EE9u h\u1ED9 xe v\xE0 b\xE0n giao t\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490454
    m_Localized: "Nhi\u1EC7m v\u1EE5 \u0111\xE3 xong xu\u1EA5t hi\u1EC7n t\u1EA1i
      \u0111\xE2y \u0111\u1EC3 ch\u01A1i l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490455
    m_Localized: "Kh\xF4ng m\u1EA5t ti\u1EC1n cho \u0111\u1EBFn khi b\u1EA1n ch\u1ECDn
      Mua & L\u1EAFp."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490456
    m_Localized: "Ph\u1EA3i s\u1EDF h\u1EEFu xe n\xE0y tr\u01B0\u1EDBc khi l\u1EAFp
      ph\u1EE5 t\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490457
    m_Localized: "Kh\xF4ng th\u1EC3 \u0111\u1ECDc s\u1EF1 nghi\u1EC7p. B\u1EA3n l\u01B0u
      g\u1ED1c \u0111\u01B0\u1EE3c gi\u1EEF nguy\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490458
    m_Localized: "Ph\xEDm n\xE0y d\xE0nh ri\xEAng cho menu ho\u1EB7c m\xE1y quay."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490459
    m_Localized: "C\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490460
    m_Localized: "\u0110\u1ED9 ph\xE2n gi\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490461
    m_Localized: "\u0110ang ch\u1EDD l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490462
    m_Localized: "Kh\xF4ng th\u1EC3 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490463
    m_Localized: "Khuy\xEAn d\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490464
    m_Localized: "C\u01A1 b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490465
    m_Localized: "C\u1EE9u h\u1ED9 l\u1EA7n \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490466
    m_Localized: "Kh\xF4ng \u0111\u1EE9t c\xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490467
    m_Localized: "\u0110\xE3 ho\xE0n l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490468
    m_Localized: "\u0110\xE3 l\u1EAFp v\xE0 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490469
    m_Localized: "\u0110\xE3 b\xE1n ph\u1EE5 t\xF9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490470
    m_Localized: "\u0110\u1ED9 b\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490471
    m_Localized: "Chi\u1EC1u d\xE0i"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490472
    m_Localized: "Lo\u1EA1i l\u1ED1p"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490473
    m_Localized: "B\u1ED9 b\u1ED1n b\xE1nh"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490474
    m_Localized: "Ng\u01B0\u1EE1ng \u0111\u1EE9t"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490475
    m_Localized: "C\xE1p gia c\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490476
    m_Localized: "C\xE1p chuy\xEAn nghi\u1EC7p"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490477
    m_Localized: "T\u1EDDi c\u1EA3i ti\u1EBFn"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490478
    m_Localized: "T\u1EDDi chuy\xEAn nghi\u1EC7p"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490479
    m_Localized: "C\u1EA5p \u0111\u1ED9ng c\u01A1"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490480
    m_Localized: "L\u1ED1p n\xFAi n\u1EB7ng"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490481
    m_Localized: "\u0110\u1ED9ng c\u01A1"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490482
    m_Localized: "Ch\u1EAFn b\xF9n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490483
    m_Localized: "B\xE1nh xe"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490484
    m_Localized: "C\u1EA3n tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490485
    m_Localized: "N\xF3c xe"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490486
    m_Localized: "H\u1EC7 th\u1ED1ng n\u1EA1p"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490487
    m_Localized: "\u1ED0ng x\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490488
    m_Localized: "Nguy\xEAn b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490489
    m_Localized: "Nguy\xEAn b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490490
    m_Localized: "Th\u1EBB sau"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490491
    m_Localized: "Ch\u1ECDn"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490492
    m_Localized: "\u0110i\u1EC1u h\u01B0\u1EDBng"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490493
    m_Localized: "\u0110i\u1EC1u h\u01B0\u1EDBng"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490494
    m_Localized: "T\u0103ng t\u1ED1c"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490495
    m_Localized: "Th\xE1o c\xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490496
    m_Localized: "L\u1EF1c k\xE9o"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490497
    m_Localized: "Kho\u1EA3ng s\xE1ng g\u1EA7m"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490498
    m_Localized: "Tuy\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490499
    m_Localized: "C\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490500
    m_Localized: "B\xF9n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490501
    m_Localized: "Chi\u1EC1u d\xE0i t\u1ED1i thi\u1EC3u"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490502
    m_Localized: "Chi\u1EC1u d\xE0i t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490503
    m_Localized: "{0}\n\nKh\xF4i ph\u1EE5c m\u1EB7c \u0111\u1ECBnh cho th\u1EBB n\xE0y?
      Ti\u1EBFn tr\xECnh s\u1EF1 nghi\u1EC7p \u0111\u01B0\u1EE3c gi\u1EEF nguy\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490504
    m_Localized: "{0}\n\nCh\u1ECDn thao t\xE1c \u0111\u1EC3 \u0111\u1ED5i ph\xEDm.
      M\u1ED7i ph\xEDm ch\u1EC9 \u0111\u01B0\u1EE3c g\xE1n m\u1ED9t thao t\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490505
    m_Localized: "{0}\nNh\u1EA5n m\u1ED9t ph\xEDm. Esc \u0111\u1EC3 h\u1EE7y."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490506
    m_Localized: "Gi\u1EEF c\xE0i \u0111\u1EB7t hi\u1EC3n th\u1ECB? N\u1EBFu kh\xF4ng
      x\xE1c nh\u1EADn, c\xE0i \u0111\u1EB7t s\u1EBD tr\u1EDF l\u1EA1i sau 15 gi\xE2y.\nTh\u1EDDi
      gian: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490507
    m_Localized: "{0}\n\nThay c\u1EA5u h\xECnh \u0111\xE3 l\u01B0u n\xE0y b\u1EB1ng
      trang b\u1ECB \u0111ang l\u1EAFp?\nL\u01B0u trang b\u1ECB \u0111ang l\u1EAFp.
      Ph\u1EE5 t\xF9ng \u0111ang xem th\u1EED kh\xF4ng \u0111\u01B0\u1EE3c l\u01B0u."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490508
    m_Localized: "{0} \xB7 \u0110\xE3 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490509
    m_Localized: "{0} \xB7 \u0110\xE3 l\u1EAFp v\xE0 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490510
    m_Localized: "{0} \xB7 Nguy\xEAn b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490511
    m_Localized: "\u0110\xE3 l\u1EAFp \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490512
    m_Localized: "C\u1EA5u h\xECnh \u0111\xE3 l\u01B0u \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490513
    m_Localized: "B\xE0n giao \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490514
    m_Localized: "Ng\xF4n ng\u1EEF: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490515
    m_Localized: "Ch\u1ECDn nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490516
    m_Localized: "B\xE1n {0} \xB7 {1} CR?\nB\xE1n ph\u1EE5 t\xF9ng n\xE0y? B\u1EA1n
      ph\u1EA3i mua l\u1EA1i n\u1EBFu mu\u1ED1n d\xF9ng ti\u1EBFp."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490517
    m_Localized: "{0} \xB7 Thu c\xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490518
    m_Localized: "{0} / {1} \xB7 T\u0103ng t\u1ED1c / L\xF9i"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490519
    m_Localized: "{0} \xB7 T\u0103ng t\u1ED1c / L\xF9i\n{1} \xB7 \u0110\xE1nh l\xE1i\nPhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144502
    m_Localized: "Hi\u1EC7u n\u0103ng gi\u1EA3m chi ti\u1EBFt. Ch\u1EA5t l\u01B0\u1EE3ng
      gi\u1EEF nhi\u1EC1u chi ti\u1EBFt h\u01A1n. \xC1p d\u1EE5ng \u0111\u1EC3 xem
      th\u1EED."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144503
    m_Localized: "\u0110\u1EA3o chi\u1EC1u chuy\u1EC3n \u0111\u1ED9ng d\u1ECDc c\u1EE7a
      m\xE1y quay."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144504
    m_Localized: "Hi\u1EC3n th\u1ECB g\u1EE3i \xFD theo t\xECnh hu\u1ED1ng. M\u1EE5c
      ti\xEAu v\xE0 c\u1EA3nh b\xE1o c\xE1p v\u1EABn hi\u1EC3n th\u1ECB."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144505
    m_Localized: "G\u1EE3i \xFD gi\xFAp b\u1EA1n h\u1ECDc c\xE1ch ch\u01A1i. \u0110\u1EB7t
      l\u1EA1i ti\u1EBFn tr\xECnh x\xF3a s\u1EF1 nghi\u1EC7p v\xE0 gi\u1EEF t\xF9y
      ch\u1ECDn."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144506
    m_Localized: "T\u1EDDi ch\u1EADm l\u1EA1i khi ch\u1ECBu t\u1EA3i v\xE0 d\u1EEBng
      \u1EDF gi\u1EDBi h\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144507
    m_Localized: "Ph\u1EE5 t\xF9ng n\xE0y ch\u1EC9 thay \u0111\u1ED5i ngo\u1EA1i
      h\xECnh."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144508
    m_Localized: "Ch\u1ECDn T\u1EA5t c\u1EA3 ho\u1EB7c lo\u1EA1i l\u1ED1p kh\xE1c
      \u0111\u1EC3 xem th\xEAm ph\u1EE5 t\xF9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960810
    m_Localized: "C\xE1p nguy\xEAn b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960811
    m_Localized: "C\xE1p nh\u1EB9"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960812
    m_Localized: "C\xE1p ti\xEAu chu\u1EA9n"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960813
    m_Localized: "T\u1EDDi nguy\xEAn b\u1EA3n"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871528
    m_Localized: "L\xE1i xe"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871529
    m_Localized: "C\xE2n b\u1EB1ng kh\u1ED1i l\u01B0\u1EE3ng v\xE0 l\u1EF1c k\xE9o."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871530
    m_Localized: "Linh ho\u1EA1t; \xEDt tr\u1ECDng l\u01B0\u1EE3ng \u0111\u1EC3 gi\u1EEF
      xe."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871531
    m_Localized: "B\xE1m tr\u1EE5 t\u1ED1t h\u01A1n; n\u1EB7ng h\u01A1n khi l\xEAn
      d\u1ED1c."
    m_Metadata:
      m_Items: []
  - m_Id: 51321251028992
    m_Localized: "Ch\u01A1i l\u1EA1i \xB7 C\u01A1 b\u1EA3n {0} CR + Ti\u1EC1n th\u01B0\u1EDFng
      {1} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 51321255223296
    m_Localized: "C\u01A1 b\u1EA3n {0} CR + Ti\u1EC1n th\u01B0\u1EDFng {1} CR \xB7
      C\u1EE9u h\u1ED9 l\u1EA7n \u0111\u1EA7u +25%"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
