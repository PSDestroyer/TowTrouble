    m_Localized: "\u0110a \u0111\u1ECBa h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118233
    m_Localized: "\u0110a \u0111\u1ECBa h\xECnh \xB7 B\u1ED9 b\u1ED1n b\xE1nh \xB7
      \u0110\u01B0\u1EDDng: 0% \xB7 B\xF9n: +10% \xB7 C\xE1t: 0% \xB7 Tuy\u1EBFt:
      0% \xB7 Kh\u1ED1i l\u01B0\u1EE3ng: 0 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118234
    m_Localized: "L\u1ED1p b\xF9n"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118235
    m_Localized: "B\xF9n \xB7 B\u1ED9 b\u1ED1n b\xE1nh \xB7 \u0110\u01B0\u1EDDng:
      0% \xB7 B\xF9n: +30% \xB7 C\xE1t: 0% \xB7 Tuy\u1EBFt: 0% \xB7 Kh\u1ED1i l\u01B0\u1EE3ng:
      0 kg \xB7 L\u1EF1c c\u1EA3n b\xF9n: -15%"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118236
    m_Localized: "L\u1ED1p c\xE1t b\u1EA3n r\u1ED9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118237
    m_Localized: "B\u1EA3n r\u1ED9ng cho c\xE1t \xB7 B\u1ED9 b\u1ED1n b\xE1nh \xB7
      \u0110\u01B0\u1EDDng: 0% \xB7 B\xF9n: -10% \xB7 C\xE1t: +45% \xB7 Tuy\u1EBFt:
      0% \xB7 Kh\u1ED1i l\u01B0\u1EE3ng: 0 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118238
    m_Localized: "L\u1ED1p m\xF9a \u0111\xF4ng c\xF3 \u0111inh"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118239
    m_Localized: "M\xF9a \u0111\xF4ng c\xF3 \u0111inh \xB7 B\u1ED9 b\u1ED1n b\xE1nh
      \xB7 \u0110\u01B0\u1EDDng: 0% \xB7 B\xF9n: -15% \xB7 C\xE1t: 0% \xB7 Tuy\u1EBFt:
      +65% \xB7 Kh\u1ED1i l\u01B0\u1EE3ng: 0 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118240
    m_Localized: "C\u1EA5p \u0111\u1ED9ng c\u01A1 2"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118241
    m_Localized: "L\u1EF1c k\xE9o +20%. \u0110\u1ED9 b\xE1m gi\u1EDBi h\u1EA1n l\u1EF1c
      k\xE9o h\u1EEFu d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118242
    m_Localized: "C\u1EA5p \u0111\u1ED9ng c\u01A1 3"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118243
    m_Localized: "L\u1EF1c k\xE9o +35% \xB7 Nguy\xEAn b\u1EA3n > C\u1EA5p \u0111\u1ED9ng
      c\u01A1 3"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118244
    m_Localized: "S\u1ED1 ch\u1EADm"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118245
    m_Localized: "L\u1EF1c k\xE9o +25% \xB7 T\u1ED1c \u0111\u1ED9 -20%"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118246
    m_Localized: "H\u1EC7 treo \u0111\u1ECBa h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118247
    m_Localized: "Kho\u1EA3ng s\xE1ng g\u1EA7m +15 cm \xB7 H\u1EC7 treo \u0111\u1ECBa
      h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118248
    m_Localized: "C\xE1p gia c\u01B0\u1EDDng \xB7 26 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118249
    m_Localized: "Ng\u01B0\u1EE1ng \u0111\u1EE9t: 26 kN. L\xE1i nh\u1EB9 nh\xE0ng.
      K\xE9o \u0111\u1EC1u v\xE0 tr\xE1nh gi\u1EADt c\xE1p \u0111\u1ED9t ng\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118250
    m_Localized: "C\xE1p chuy\xEAn nghi\u1EC7p \xB7 36 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118251
    m_Localized: "Ng\u01B0\u1EE1ng \u0111\u1EE9t: 36 kN. L\xE1i nh\u1EB9 nh\xE0ng.
      K\xE9o \u0111\u1EC1u v\xE0 tr\xE1nh gi\u1EADt c\xE1p \u0111\u1ED9t ng\u1ED9t."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118252
    m_Localized: "T\u1EDDi c\u1EA3i ti\u1EBFn \xB7 14 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118253
    m_Localized: "L\u1EF1c t\u1EDDi: 14 kN \xB7 T\u1ED1c \u0111\u1ED9 cu\u1ED1n:
      1.3 m/s. T\u1EDDi ch\u1EADm l\u1EA1i khi ch\u1ECBu t\u1EA3i v\xE0 d\u1EEBng
      \u1EDF gi\u1EDBi h\u1EA1n. \u0110\u1ED9 b\xE1m gi\u1EDBi h\u1EA1n l\u1EF1c
      k\xE9o h\u1EEFu d\u1EE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118254
    m_Localized: "L\u1EDBp s\u01A1n th\xE2n xe."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118255
    m_Localized: "L\u1ED1p n\xFAi n\u1EB7ng B\xE1nh xe"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118256
    m_Localized: "L\u1ED1p n\xFAi n\u1EB7ng \xB7 B\u1ED9 b\u1ED1n b\xE1nh \xB7 \u0110\u01B0\u1EDDng:
      0% \xB7 B\xF9n: -20% \xB7 C\xE1t: 0% \xB7 Tuy\u1EBFt: +135% \xB7 Kh\u1ED1i
      l\u01B0\u1EE3ng: +35 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118257
    m_Localized: "T\u1EDDi chuy\xEAn nghi\u1EC7p \xB7 22 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118258
    m_Localized: "L\u1EF1c t\u1EDDi: 22 kN \xB7 T\u1ED1c \u0111\u1ED9 cu\u1ED1n:
      0.85 m/s. T\u1EDDi ch\u1EADm l\u1EA1i khi ch\u1ECBu t\u1EA3i v\xE0 d\u1EEBng
      \u1EDF gi\u1EDBi h\u1EA1n. \u0110\u1ED9 b\xE1m gi\u1EDBi h\u1EA1n l\u1EF1c
      k\xE9o h\u1EEFu d\u1EE5ng \xB7 Khuy\xEAn d\xF9ng: C\xE1p 26 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118259
    m_Localized: "\u0110\u1ED3ng c\u1ECF x\u01B0\u1EDFng"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118260
    m_Localized: "M\u1ED9t b\xE1nh xe m\u1EAFc trong r\xE3nh. K\xE9o \u0111\u1EC1u
      v\u1EC1 ph\xEDa \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118261
    m_Localized: "R\xE3nh b\xE1nh trong r\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118262
    m_Localized: "D\u1ECDn c\xE2y \u0111\u1ED5 tr\u01B0\u1EDBc khi c\u1EE9u h\u1ED9
      xe. G\u1EA7m xe m\u1EAFc trong b\xF9n. K\xE9o t\u1EEB n\u1EC1n \u0111\u1EA5t
      ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118263
    m_Localized: "Tr\u1EA1m l\xE2m nghi\u1EC7p"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118264
    m_Localized: "H\u1ED1 b\xF9n"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118265
    m_Localized: "G\u1EA7m xe m\u1EAFc trong b\xF9n. K\xE9o t\u1EEB n\u1EC1n \u0111\u1EA5t
      ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118266
    m_Localized: "Khe ki\u1EC3m l\xE2m"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118267
    m_Localized: "D\u1ECDn c\xE2y \u0111\u1ED5 tr\u01B0\u1EDBc khi c\u1EE9u h\u1ED9
      xe. Xe tr\u01B0\u1EE3t xu\u1ED1ng d\u01B0\u1EDBi \u0111\u01B0\u1EDDng. K\xE9o
      l\xEAn d\u1ED1c theo l\u1ED1i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118268
    m_Localized: "B\u1EBFn h\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118269
    m_Localized: "B\u1EDD c\xE2u c\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118270
    m_Localized: "Xe b\u1ECB ng\u1EADp m\u1ED9t ph\u1EA7n. K\xE9o v\u1EC1 ph\xEDa
      b\u1EDD kh\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118271
    m_Localized: "B\u1EDD lau s\u1EADy"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118272
    m_Localized: "D\u1ECDn c\xE2y \u0111\u1ED5 tr\u01B0\u1EDBc khi c\u1EE9u h\u1ED9
      xe. Xe b\u1ECB ng\u1EADp m\u1ED9t ph\u1EA7n. K\xE9o v\u1EC1 ph\xEDa b\u1EDD
      kh\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118273
    m_Localized: "\u0110\xE1 t\u1EA3ng ven b\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118274
    m_Localized: "Xe tr\u01B0\u1EE3t xu\u1ED1ng d\u01B0\u1EDBi \u0111\u01B0\u1EDDng.
      K\xE9o l\xEAn d\u1ED1c theo l\u1ED1i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118275
    m_Localized: "V\u1ECBnh \u1EA9n"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118276
    m_Localized: "Xe b\u1ECB ng\u1EADp m\u1ED9t ph\u1EA7n. K\xE9o v\u1EC1 ph\xEDa
      b\u1EDD kh\xF4."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118277
    m_Localized: "Kh\xFAc cua s\u1ECFi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118278
    m_Localized: "\u0110\u1ED9ng c\u01A1 ho\u1EB7c phanh b\u1ECB h\u1ECFng. Nh\u1EB9
      nh\xE0ng gi\u1EA3i c\u1EE9u xe r\u1ED3i k\xE9o \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118279
    m_Localized: "N\u01A1i tr\xFA tr\xEAn n\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118280
    m_Localized: "D\u01B0\u1EDBi \u0111\u01B0\u1EDDng n\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118281
    m_Localized: "Xe tr\u01B0\u1EE3t xu\u1ED1ng d\u01B0\u1EDBi \u0111\u01B0\u1EDDng.
      K\xE9o l\xEAn d\u1ED1c theo l\u1ED1i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118282
    m_Localized: "D\u01B0\u1EDBi \u0111\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118283
    m_Localized: "Xe tr\u01B0\u1EE3t xu\u1ED1ng d\u01B0\u1EDBi \u0111\u01B0\u1EDDng.
      K\xE9o l\xEAn d\u1ED1c theo l\u1ED1i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118284
    m_Localized: "Tr\u01B0\u1EE3t kh\u1ECFi cua g\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118285
    m_Localized: "Tr\u1EA1m h\u1EBBm n\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118286
    m_Localized: "Tuy\u1EBFt \u0111\u1EA7u m\xF9a"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118287
    m_Localized: "Tuy\u1EBFt ho\u1EB7c b\u0103ng gi\u1EEF ch\u1EB7t b\xE1nh xe. K\xE9o
      theo v\u1EC7t b\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118288
    m_Localized: "Nh\xE0 g\u1ED7 tr\xEAn cao"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118289
    m_Localized: "Cua g\u1EA5p \u0111\xF3ng b\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118290
    m_Localized: "D\u1ECDn c\xE2y \u0111\u1ED5 tr\u01B0\u1EDBc khi c\u1EE9u h\u1ED9
      xe. Tuy\u1EBFt ho\u1EB7c b\u0103ng gi\u1EEF ch\u1EB7t b\xE1nh xe. K\xE9o theo
      v\u1EC7t b\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118291
    m_Localized: "R\xE3nh b\xE3o tuy\u1EBFt"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118292
    m_Localized: "Tuy\u1EBFt ho\u1EB7c b\u0103ng gi\u1EEF ch\u1EB7t b\xE1nh xe. K\xE9o
      theo v\u1EC7t b\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118293
    m_Localized: "Cao nguy\xEAn \u0111\u1EC9nh n\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118294
    m_Localized: "\u0110\u1ED9ng c\u01A1 ho\u1EB7c phanh b\u1ECB h\u1ECFng. Nh\u1EB9
      nh\xE0ng gi\u1EA3i c\u1EE9u xe r\u1ED3i k\xE9o \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118295
    m_Localized: "L\u1ED1i v\xE0o \u0111\u1EA7y c\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118296
    m_Localized: "B\xE1nh xe b\u1ECB v\xF9i trong c\xE1t. K\xE9o t\u1EEB n\u1EC1n
      \u0111\u1EA5t ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118297
    m_Localized: "B\xE3i \u0111\u1ED7 ven bi\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118298
    m_Localized: "V\xE1ch th\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118299
    m_Localized: "D\u1ECDn c\xE2y \u0111\u1ED5 tr\u01B0\u1EDBc khi c\u1EE9u h\u1ED9
      xe. Xe tr\u01B0\u1EE3t xu\u1ED1ng d\u01B0\u1EDBi \u0111\u01B0\u1EDDng. K\xE9o
      l\xEAn d\u1ED1c theo l\u1ED1i l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118300
    m_Localized: "C\xE1t \u01B0\u1EDBt"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118301
    m_Localized: "B\xE1nh xe b\u1ECB v\xF9i trong c\xE1t. K\xE9o t\u1EEB n\u1EC1n
      \u0111\u1EA5t ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118302
    m_Localized: "\u0110\u1EE5n c\xE1t ven h\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118303
    m_Localized: "B\xE1nh xe b\u1ECB v\xF9i trong c\xE1t. K\xE9o t\u1EEB n\u1EC1n
      \u0111\u1EA5t ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118304
    m_Localized: "L\xF2ng su\u1ED1i c\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118305
    m_Localized: "Xe m\u1EAFc trong l\xF2ng su\u1ED1i c\u1EA1n. D\xF9ng d\u1ED1c
      tho\xE1t ra."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118306
    m_Localized: "Tr\u1EA1m d\u1EEBng sa m\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118307
    m_Localized: "\u0110\u1EE5n c\xE1t s\xE2u"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118308
    m_Localized: "B\xE1nh xe b\u1ECB v\xF9i trong c\xE1t. K\xE9o t\u1EEB n\u1EC1n
      \u0111\u1EA5t ch\u1EAFc."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118309
    m_Localized: "Ta luy \u0111\u01B0\u1EDDng h\u1EBBm n\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118310
    m_Localized: "D\u1ED1c c\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118311
    m_Localized: "\u0110\u1ED9ng c\u01A1 ho\u1EB7c phanh b\u1ECB h\u1ECFng. Nh\u1EB9
      nh\xE0ng gi\u1EA3i c\u1EE9u xe r\u1ED3i k\xE9o \u0111i."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118312
    m_Localized: "Nh\xE0 g\u1ED7 tr\xEAn cao"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118313
    m_Localized: "Khu b\xE0n giao"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118314
    m_Localized: "N\u01A1i tr\xFA tr\xEAn n\xFAi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118315
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118316
