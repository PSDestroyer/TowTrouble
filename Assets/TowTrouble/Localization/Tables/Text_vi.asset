    m_Localized: "\u0110ang th\u1EF1c hi\u1EC7n: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118353
    m_Localized: "S\u1ED1 d\u01B0  {0} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118354
    m_Localized: "C\u1EA7n {0} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118355
    m_Localized: "Mua v\xE0 l\u1EAFp \xB7 {0} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118356
    m_Localized: "{0} \xB7 \u0110\xE3 l\u1EAFp v\xE0 l\u01B0u"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118357
    m_Localized: "\u0110\xE3 b\xE1n ph\u1EE5 t\xF9ng \xB7 {0} CR \xB7 \u0110\xE3
      ho\xE0n l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118358
    m_Localized: "C\u01A1 b\u1EA3n {0} CR + Ti\u1EC1n th\u01B0\u1EDFng {1} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118359
    m_Localized: "Th\u1EDDi gian: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118360
    m_Localized: "Ch\u1ECDn {0}?\n\nCh\u1ECDn mi\u1EC5n ph\xED m\u1ED9t xe kh\u1EDFi
      \u0111\u1EA7u. Mua c\xE1c xe kh\xE1c t\u1EA1i x\u01B0\u1EDFng sau."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118361
    m_Localized: "{0}\n\nR\u1EDDi nhi\u1EC7m v\u1EE5 n\xE0y m\xE0 kh\xF4ng nh\u1EADn
      ti\u1EC1n c\xF4ng? Trang b\u1ECB \u0111\xE3 mua v\xE0 ti\u1EC1n ki\u1EBFm \u0111\u01B0\u1EE3c
      v\u1EABn \u0111\u01B0\u1EE3c gi\u1EEF l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118362
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n \xB7 \u0110\xE3 kh\xF3a: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118363
    m_Localized: "Ch\u1EA5t l\u01B0\u1EE3ng: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118364
    m_Localized: "\u0110\u1ED9 ph\xE2n gi\u1EA3i: {0} \xD7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118365
    m_Localized: "Hi\u1EC3n th\u1ECB: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118366
    m_Localized: "\u0110\u1EA3o tr\u1EE5c Y m\xE1y quay: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118367
    m_Localized: "Gi\u1EA3m chuy\u1EC3n \u0111\u1ED9ng: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118368
    m_Localized: "K\xFD hi\u1EC7u \u0111\u1ED9 c\u0103ng: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118369
    m_Localized: "G\u1EE3i \xFD h\u01B0\u1EDBng d\u1EABn: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118370
    m_Localized: "Rung tay c\u1EA7m: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118371
    m_Localized: "{0} \xB7 Nhi\u1EC7m v\u1EE5 c\u1EE9u h\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118372
    m_Localized: "{0} \xB7 Ga-ra"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118373
    m_Localized: "{0} \xB7 Open the X\u01B0\u1EDFng"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118374
