      m_Items: []
  - m_Id: 4717535413
    m_Localized: "Handledningshj\xE4lp "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535414
    m_Localized: "Visar sammanhangsberoende tips. M\xE5l och vajervarningar f\xF6rblir
      synliga."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535415
    m_Localized: 'Handkontrollsvibration '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535416
    m_Localized: "Mjuk \xE5terkoppling f\xF6r vajer, vinsch, st\xF6tar och b\xE4rgningar.
      Kan st\xE4ngas av n\xE4r som helst."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535417
    m_Localized: Vibrationsstyrka
    m_Metadata:
      m_Items: []
  - m_Id: 4717535418
    m_Localized: "S\xE5 spelar du"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535419
    m_Localized: "\xD6va k\xF6rning, vajeranslutning, vinschning och leverans. Din
      karri\xE4r p\xE5verkas inte."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535420
    m_Localized: "Nollst\xE4ll framsteg"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535421
    m_Localized: "Radera alla framsteg? Pengar, fordon, utrustning och upps\xE4ttningar
      raderas. Inst\xE4llningar beh\xE5lls."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535422
    m_Localized: "Radera alla framsteg? Pengar, fordon, utrustning och upps\xE4ttningar
      raderas. Inst\xE4llningar beh\xE5lls."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535423
    m_Localized: "L\xE4mna sessionen innan du nollst\xE4ller framsteg."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535424
    m_Localized: "\xC5terst\xE4ll fliken"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535425
    m_Localized: "\xC5terst\xE4ll standardv\xE4rden "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535426
    m_Localized: " \xC5terst\xE4ll den h\xE4r fliken? Karri\xE4rframsteg beh\xE5lls."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535427
    m_Localized: "\xC5terst\xE4ll standardv\xE4rden"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535428
    m_Localized: "F\xF6reg\xE5ende flik"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535429
    m_Localized: "N\xE4sta flik"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535430
    m_Localized: TOW TROUBLE
    m_Metadata:
      m_Items: []
  - m_Id: 4717535431
    m_Localized: "Du kan \xE4ndra inst\xE4llningarna senare."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535432
    m_Localized: "G\xF6r det bekv\xE4mt"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535433
    m_Localized: "Du kan \xE4ndra inst\xE4llningarna senare."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535434
    m_Localized: "V\xE4lj ditt f\xF6rsta fordon"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535435
    m_Localized: Justera volymerna separat. Visuella varningar finns kvar.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535436
    m_Localized: "Grafiken anpassas automatiskt f\xF6r denna konsol."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535437
    m_Localized: "Beh\xE5lla bildinst\xE4llningarna? Utan bekr\xE4ftelse \xE5terst\xE4lls
      de efter 15 sekunder."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535438
    m_Localized: "Anslut en handkontroll f\xF6r att se dess knappar. Tangentbord
      och mus kan fortfarande anv\xE4ndas."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535439
    m_Localized: "V\xE4lj en kontroll f\xF6r att byta tangent. Varje tangent kan
      bara ha en \xE5tg\xE4rd."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535440
    m_Localized: "Textstorlek och kamerak\xE4nslighet kan \xE4ndras n\xE4r som helst."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535441
    m_Localized: "Tips hj\xE4lper dig l\xE4ra dig. \xC5terst\xE4ll framsteg raderar
      karri\xE4ren och beh\xE5ller inst\xE4llningar."
    m_Metadata:
      m_Items: []
