    m_Metadata:
      m_Items: []
  - m_Id: 3520848715778
    m_Localized: "\xC5terst\xE4ll kamera"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715779
    m_Localized: "Helsk\xE4rm"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715780
    m_Localized: "F\xF6nster"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715781
    m_Localized: Varning
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715782
    m_Localized: "Tr\xE4ning"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715783
    m_Localized: Invertera kamerans Y-axel
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715784
    m_Localized: "B\xE4rga"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715785
    m_Localized: Allround
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715786
    m_Localized: "Breda sandd\xE4ck"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715787
    m_Localized: "Dubbade vinterd\xE4ck"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715788
    m_Localized: Alpin
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715789
    m_Localized: "Lermotst\xE5nd"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715790
    m_Localized: "Markfrig\xE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715791
    m_Localized: Bonusar
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715792
    m_Localized: Ditt fordon
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715793
    m_Localized: "V\xE4lj"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715794
    m_Localized: "J\xE4mf\xF6r fordon"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715795
    m_Localized: "K\xF6p och montera"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715796
    m_Localized: "Tr\xE4ning slutf\xF6rd"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715797
    m_Localized: Starta
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715798
    m_Localized: "Uppl\xE5st"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715799
    m_Localized: "L\xE5st"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715800
    m_Localized: Lag
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715801
    m_Localized: "V\xE4rd"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715802
    m_Localized: Anslut
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490410
    m_Localized: "V\xE4lj en b\xE4rgning, f\xF6rbered fordonet och l\xE4mna av bilen."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490411
    m_Localized: "K\xF6r f\xF6rsiktigt. Dra j\xE4mnt och undvik ryck i vajern."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490412
    m_Localized: "Flytta det fallna tr\xE4det innan bilen b\xE4rgas."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490413
    m_Localized: "Anv\xE4nd vinschen fr\xE5n fast mark f\xF6r att befria fordonet."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490414
    m_Localized: "Bogsera den befriade bilen till markeringen och stanna innanf\xF6r."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490415
    m_Localized: "F\xF6rhandsvisa delar f\xF6re k\xF6p. \xC4gda delar monteras gratis."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490416
    m_Localized: "V\xE4lj ditt f\xF6rsta fordon gratis. Andra k\xF6ps senare i verkstaden."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490417
    m_Localized: "Ljud- och kontrollinst\xE4llningar sparas automatiskt."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490418
    m_Localized: Justera volymerna separat. Visuella varningar finns kvar.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490419
    m_Localized: "V\xE4lj en kontroll f\xF6r att byta tangent. Varje tangent kan
      bara ha en \xE5tg\xE4rd."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490420
    m_Localized: "Anslut en handkontroll f\xF6r att se dess knappar. Tangentbord
      och mus kan fortfarande anv\xE4ndas."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490421
    m_Localized: "Minska kamera- och menyr\xF6relser f\xF6r \xF6kad komfort."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490422
    m_Localized: "Visa symboler ut\xF6ver f\xE4rger f\xF6r vajersp\xE4nning."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490423
    m_Localized: "Textstorlek och kamerak\xE4nslighet kan \xE4ndras n\xE4r som helst."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490424
    m_Localized: "\xC5terst\xE4ll den h\xE4r fliken? Karri\xE4rframsteg beh\xE5lls."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490425
    m_Localized: "Radera alla framsteg? Pengar, fordon, utrustning och upps\xE4ttningar
      raderas. Inst\xE4llningar beh\xE5lls."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490426
    m_Localized: "L\xE4mna sessionen innan du nollst\xE4ller framsteg."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490427
    m_Localized: "Beh\xE5lla bildinst\xE4llningarna? Utan bekr\xE4ftelse \xE5terst\xE4lls
      de efter 15 sekunder."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490428
    m_Localized: "De h\xE4r delarna passar inte den nya karossen. De finns kvar i
      ditt f\xF6rr\xE5d."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490429
    m_Localized: "S\xE4lja den h\xE4r delen? Du m\xE5ste k\xF6pa den igen f\xF6r
      att anv\xE4nda den."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490430
    m_Localized: "Spara monterad utrustning. Delar som bara f\xF6rhandsvisas sparas
      inte."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490431
    m_Localized: "Ers\xE4tta den h\xE4r upps\xE4ttningen med monterad utrustning?"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490432
    m_Localized: "\xD6va k\xF6rning, vajeranslutning, vinschning och leverans. Din
      karri\xE4r p\xE5verkas inte."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490433
    m_Localized: "Tr\xE4ningen kan hoppas \xF6ver och spelas om via S\xE5 spelar
      du."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490434
    m_Localized: "V\xE4rden v\xE4ljer b\xE4rgningen f\xF6r laget."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490435
    m_Localized: "Dela v\xE4rdens lokala IP-adress f\xF6r att spela tillsammans."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490436
    m_Localized: "Startar spelet. V\xE4nta lite."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490437
    m_Localized: "Spelet kunde inte starta. G\xE5 tillbaka till menyn och f\xF6rs\xF6k
      igen."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490438
    m_Localized: "Avbryta utan betalning? K\xF6pt utrustning och intj\xE4nade pengar
      beh\xE5lls."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490439
    m_Localized: "Anv\xE4nd l\xE4mpliga d\xE4ck, tillr\xE4cklig dragkraft och en
      stark vajer."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490440
    m_Localized: "H\xF6gre massa hj\xE4lper f\xF6rankringen men g\xF6r bogsering
      uppf\xF6r tyngre."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490441
    m_Localized: "Stanna n\xE4ra verkstaden f\xF6r att \xF6ppna garaget."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490442
    m_Localized: "Du kan \xE4ndra inst\xE4llningarna senare."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490443
    m_Localized: "Din karri\xE4rutrustning \xE4r \xE5terst\xE4lld. V\xE4lj en b\xE4rgning
      n\xE4r du \xE4r redo."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490444
    m_Localized: "Vinscha f\xF6rsiktigt och h\xE5ll vajern riktad mot v\xE4gen ut."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490445
    m_Localized: "Ett hjul sitter i ett sp\xE5r. Dra j\xE4mnt mot v\xE4gen."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490446
    m_Localized: "Chassit sitter fast i leran. Dra fr\xE5n fast mark."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490447
    m_Localized: "Bilen \xE4r delvis under vatten. Dra mot den torra stranden."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490448
    m_Localized: "Bilen har glidit nedanf\xF6r v\xE4gen. Dra upp den l\xE4ngs rampen."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490449
    m_Localized: "Sn\xF6 eller is har f\xE5ngat hjulen. Dra l\xE4ngs sp\xE5ren."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490450
    m_Localized: "Hjulen \xE4r begravda i sand. Dra fr\xE5n fast mark."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490451
    m_Localized: "Motorn eller bromsarna \xE4r trasiga. Befria bilen f\xF6rsiktigt
      och bogsera den."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490452
    m_Localized: "Bilen sitter i en torr f\xE5ra. Anv\xE4nd utfartsrampen."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490453
    m_Localized: "B\xE4rga bilen och l\xE4mna den vid"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490454
    m_Localized: "Slutf\xF6rda b\xE4rgningar visas h\xE4r f\xF6r omspelning."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490455
    m_Localized: "Inga pengar anv\xE4nds f\xF6rr\xE4n du v\xE4ljer K\xF6p och montera."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490456
    m_Localized: "Du m\xE5ste \xE4ga fordonet innan du kan montera delar."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490457
    m_Localized: "Karri\xE4ren kunde inte l\xE4sas. Den ursprungliga sparfilen \xE4r
      bevarad."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490458
    m_Localized: "Den h\xE4r tangenten \xE4r reserverad f\xF6r menyer eller kameran."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490459
    m_Localized: "Beh\xF6ver"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490460
    m_Localized: "Uppl\xF6sning"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490461
    m_Localized: "V\xE4ntar p\xE5 att sparas"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490462
    m_Localized: "Sparande otillg\xE4ngligt"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490463
    m_Localized: Rekommenderat
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490464
    m_Localized: Grundbelopp
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490465
    m_Localized: "F\xF6rsta b\xE4rgningen"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490466
    m_Localized: Inga vajerbrott
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490467
    m_Localized: "\xC5terbetalat"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490468
    m_Localized: Monterat och sparat
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490469
    m_Localized: "Del s\xE5ld"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490470
    m_Localized: Styrka
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490471
    m_Localized: "L\xE4ngd"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490472
    m_Localized: "D\xE4cktyp"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490473
    m_Localized: Sats med fyra hjul
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490474
