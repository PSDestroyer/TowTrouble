  - m_Id: 4721729716
    m_Localized: Pausat
    m_Metadata:
      m_Items: []
  - m_Id: 4721729717
    m_Localized: "Din bil f\xF6rblir bromsad. Ditt team forts\xE4tter spela."
    m_Metadata:
      m_Items: []
  - m_Id: 4721729718
    m_Localized: "\xC5terst\xE4ll fordon"
    m_Metadata:
      m_Items: []
  - m_Id: 4721729719
    m_Localized: "Avsluta tr\xE4ning"
    m_Metadata:
      m_Items: []
  - m_Id: 4721729720
    m_Localized: "Avsluta tr\xE4ning? \xD6va k\xF6rning, vajeranslutning, vinschning
      och leverans. Din karri\xE4r p\xE5verkas inte."
    m_Metadata:
      m_Items: []
  - m_Id: 4721729721
    m_Localized: "Avbryta utan betalning? K\xF6pt utrustning och intj\xE4nade pengar
      beh\xE5lls."
