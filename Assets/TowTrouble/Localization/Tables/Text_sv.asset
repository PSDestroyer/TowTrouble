  - m_Id: 10548241490494
    m_Localized: Accelerera
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490495
    m_Localized: Lossa vajern
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490496
    m_Localized: Dragkraft
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490497
    m_Localized: "Markfrig\xE5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490498
    m_Localized: "Sn\xF6"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490499
    m_Localized: Sand
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490500
    m_Localized: Lera
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490501
    m_Localized: "Minsta l\xE4ngd"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490502
    m_Localized: "St\xF6rsta l\xE4ngd"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490503
    m_Localized: "{0}\n\n\xC5terst\xE4ll den h\xE4r fliken? Karri\xE4rframsteg beh\xE5lls."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490504
    m_Localized: "{0}\n\nV\xE4lj en kontroll f\xF6r att byta tangent. Varje tangent
      kan bara ha en \xE5tg\xE4rd."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490505
    m_Localized: "{0}\nTryck p\xE5 en tangent. Esc avbryter."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490506
    m_Localized: "Beh\xE5lla bildinst\xE4llningarna? Utan bekr\xE4ftelse \xE5terst\xE4lls
      de efter 15 sekunder.\nTid: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490507
    m_Localized: "{0}\n\nErs\xE4tta den h\xE4r upps\xE4ttningen med monterad utrustning?\nSpara
      monterad utrustning. Delar som bara f\xF6rhandsvisas sparas inte."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490508
    m_Localized: "{0} \xB7 Sparad"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490509
    m_Localized: "{0} \xB7 Monterat och sparat"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490510
    m_Localized: "{0} \xB7 Standard"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490511
    m_Localized: "Monterade \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490512
    m_Localized: "Sparade upps\xE4ttningar \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490513
    m_Localized: "Avl\xE4mning \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490514
    m_Localized: "Spr\xE5k: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490515
    m_Localized: "V\xE4lj en b\xE4rgning"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490516
    m_Localized: "S\xE4lj {0} \xB7 {1} CR?\nS\xE4lja den h\xE4r delen? Du m\xE5ste
      k\xF6pa den igen f\xF6r att anv\xE4nda den."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490517
    m_Localized: "{0} \xB7 Vinscha in"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490518
    m_Localized: "{0} / {1} \xB7 Accelerera / Backa"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490519
    m_Localized: "{0} \xB7 Accelerera / Backa\n{1} \xB7 Styr\nBroms"
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144502
    m_Localized: "Prestanda minskar detaljerna. Kvalitet beh\xE5ller fler. Verkst\xE4ll
      f\xF6r att f\xF6rhandsvisa."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144503
    m_Localized: "V\xE4nder den vertikala kamerar\xF6relsen."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144504
    m_Localized: "Visar sammanhangsberoende tips. M\xE5l och vajervarningar f\xF6rblir
      synliga."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144505
    m_Localized: "Tips hj\xE4lper dig l\xE4ra dig. \xC5terst\xE4ll framsteg raderar
      karri\xE4ren och beh\xE5ller inst\xE4llningar."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144506
    m_Localized: "Vinschen saktar ned under belastning och stannar vid gr\xE4nsen."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144507
    m_Localized: "Den h\xE4r delen \xE4ndrar bara utseendet."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144508
    m_Localized: "V\xE4lj Alla eller en annan d\xE4cktyp f\xF6r att se fler delar."
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960810
    m_Localized: Originalvajer
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960811
    m_Localized: "L\xE4tt vajer"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960812
    m_Localized: Standardvajer
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960813
    m_Localized: Originalvinsch
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871528
    m_Localized: "K\xF6r"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871529
    m_Localized: Balans mellan massa och dragkraft.
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871530
    m_Localized: "Smidig; mindre vikt f\xF6r f\xF6rankring."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871531
    m_Localized: "B\xE4ttre f\xE4ste; tyngre i uppf\xF6rsbackar."
    m_Metadata:
      m_Items: []
