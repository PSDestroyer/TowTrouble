      m_Items: []
  - m_Id: 4730118280
    m_Localized: "Da\u011F yolunun alt\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118281
    m_Localized: "Otomobil yolun alt\u0131na kaym\u0131\u015F. Rampa boyunca yukar\u0131
      \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118282
    m_Localized: "Yolun alt\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118283
    m_Localized: "Otomobil yolun alt\u0131na kaym\u0131\u015F. Rampa boyunca yukar\u0131
