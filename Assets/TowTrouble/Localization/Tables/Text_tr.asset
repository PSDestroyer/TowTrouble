    m_Localized: "\xC7ak\u0131l viraj\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118278
    m_Localized: "Motor veya frenler ar\u0131zal\u0131. Otomobili yava\u015F\xE7a
      kurtar, sonra \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118279
    m_Localized: "Da\u011F s\u0131\u011F\u0131na\u011F\u0131"
