    m_Metadata:
      m_Items: []
  - m_Id: 4730118288
    m_Localized: "Y\xFCksek kul\xFCbe"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118289
    m_Localized: Buzlu keskin viraj
    m_Metadata:
      m_Items: []
  - m_Id: 4730118290
    m_Localized: "Otomobili kurtarmadan \xF6nce devrilen a\u011Fac\u0131 kald\u0131r.
