    m_Metadata:
      m_Items: []
  - m_Id: 4730118295
    m_Localized: "Kumlu giri\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118296
    m_Localized: "Tekerlekler kuma g\xF6m\xFClm\xFC\u015F. Sa\u011Flam zeminden \xE7ek."
    m_Metadata:
      m_Items: []
