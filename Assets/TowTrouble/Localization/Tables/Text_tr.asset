      m_Items: []
  - m_Id: 4730118285
    m_Localized: Kanyon deposu
    m_Metadata:
      m_Items: []
  - m_Id: 4730118286
    m_Localized: "\u0130lk kar"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118287
    m_Localized: "Kar veya buz tekerlekleri s\u0131k\u0131\u015Ft\u0131rm\u0131\u015F.
