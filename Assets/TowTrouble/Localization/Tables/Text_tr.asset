  - m_Id: 4730118233
    m_Localized: "Arazi \xB7 D\xF6rt tekerlek seti \xB7 Yol: 0% \xB7 \xC7amur: +10%
      \xB7 Kum: 0% \xB7 Kar: 0% \xB7 K\xFCtle: 0 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118234
    m_Localized: "\xC7amur lastikleri"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118235
    m_Localized: "\xC7amur \xB7 D\xF6rt tekerlek seti \xB7 Yol: 0% \xB7 \xC7amur:
      +30% \xB7 Kum: 0% \xB7 Kar: 0% \xB7 K\xFCtle: 0 kg \xB7 \xC7amur direnci: -15%"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118236
    m_Localized: "Geni\u015F kum lastikleri"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118237
    m_Localized: "Geni\u015F kum lastikleri \xB7 D\xF6rt tekerlek seti \xB7 Yol:
      0% \xB7 \xC7amur: -10% \xB7 Kum: +45% \xB7 Kar: 0% \xB7 K\xFCtle: 0 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118238
    m_Localized: "\xC7ivili k\u0131\u015F lastikleri"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118239
    m_Localized: "\xC7ivili k\u0131\u015F \xB7 D\xF6rt tekerlek seti \xB7 Yol: 0%
      \xB7 \xC7amur: -15% \xB7 Kum: 0% \xB7 Kar: +65% \xB7 K\xFCtle: 0 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118240
    m_Localized: Motor seviyesi 2
    m_Metadata:
      m_Items: []
  - m_Id: 4730118241
    m_Localized: "\xC7eki\u015F g\xFCc\xFC +20%. Tutu\u015F kullan\u0131labilir \xE7eki\u015Fi
      s\u0131n\u0131rlar"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118242
    m_Localized: Motor seviyesi 3
    m_Metadata:
      m_Items: []
  - m_Id: 4730118243
    m_Localized: "\xC7eki\u015F g\xFCc\xFC +35% \xB7 Standart > Motor seviyesi 3"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118244
    m_Localized: "D\xFC\u015F\xFCk vites"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118245
    m_Localized: "\xC7eki\u015F g\xFCc\xFC +25% \xB7 H\u0131z -20%"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118246
    m_Localized: "Arazi s\xFCspansiyonu"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118247
    m_Localized: "Yerden y\xFCkseklik +15 cm \xB7 Arazi s\xFCspansiyonu"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118248
    m_Localized: "G\xFC\xE7lendirilmi\u015F halat \xB7 26 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118249
    m_Localized: "Kopma e\u015Fi\u011Fi: 26 kN. Yava\u015F s\xFCr. Dengeli \xE7ek
      ve halata ani y\xFCk bindirme."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118250
    m_Localized: "Profesyonel halat \xB7 36 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118251
    m_Localized: "Kopma e\u015Fi\u011Fi: 36 kN. Yava\u015F s\xFCr. Dengeli \xE7ek
      ve halata ani y\xFCk bindirme."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118252
    m_Localized: "Geli\u015Ftirilmi\u015F vin\xE7 \xB7 14 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118253
    m_Localized: "Vin\xE7 g\xFCc\xFC: 14 kN \xB7 Sarma h\u0131z\u0131: 1.3 m/s. Vin\xE7
      y\xFCk alt\u0131nda yava\u015Flar ve s\u0131n\u0131r\u0131nda durur. Tutu\u015F
      kullan\u0131labilir \xE7eki\u015Fi s\u0131n\u0131rlar"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118254
    m_Localized: "G\xF6vde boyas\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118255
    m_Localized: "A\u011F\u0131r alp Tekerlekler"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118256
    m_Localized: "A\u011F\u0131r alp \xB7 D\xF6rt tekerlek seti \xB7 Yol: 0% \xB7
      \xC7amur: -20% \xB7 Kum: 0% \xB7 Kar: +135% \xB7 K\xFCtle: +35 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118257
    m_Localized: "Profesyonel vin\xE7 \xB7 22 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118258
    m_Localized: "Vin\xE7 g\xFCc\xFC: 22 kN \xB7 Sarma h\u0131z\u0131: 0.85 m/s.
      Vin\xE7 y\xFCk alt\u0131nda yava\u015Flar ve s\u0131n\u0131r\u0131nda durur.
      Tutu\u015F kullan\u0131labilir \xE7eki\u015Fi s\u0131n\u0131rlar \xB7 Tavsiye
      edilen: Halat 26 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118259
    m_Localized: "At\xF6lye \xE7ay\u0131r\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118260
    m_Localized: "Bir tekerlek izde s\u0131k\u0131\u015Fm\u0131\u015F. Yola do\u011Fru
      dengeli \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118261
    m_Localized: Orman izleri
    m_Metadata:
      m_Items: []
  - m_Id: 4730118262
    m_Localized: "Otomobili kurtarmadan \xF6nce devrilen a\u011Fac\u0131 kald\u0131r.
      \u015Easi \xE7amura saplanm\u0131\u015F. Sa\u011Flam zeminden \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118263
    m_Localized: Orman deposu
    m_Metadata:
      m_Items: []
  - m_Id: 4730118264
    m_Localized: "\xC7amur \xE7ukuru"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118265
    m_Localized: "\u015Easi \xE7amura saplanm\u0131\u015F. Sa\u011Flam zeminden \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118266
    m_Localized: "Ormanc\u0131 vadisi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118267
    m_Localized: "Otomobili kurtarmadan \xF6nce devrilen a\u011Fac\u0131 kald\u0131r.
      Otomobil yolun alt\u0131na kaym\u0131\u015F. Rampa boyunca yukar\u0131 \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118268
    m_Localized: "G\xF6l iskelesi"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118269
    m_Localized: "Bal\u0131k\xE7\u0131 k\u0131y\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118270
    m_Localized: "Otomobil k\u0131smen su alt\u0131nda. Kuru k\u0131y\u0131ya do\u011Fru
      \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118271
    m_Localized: "Sazl\u0131k k\u0131y\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118272
    m_Localized: "Otomobili kurtarmadan \xF6nce devrilen a\u011Fac\u0131 kald\u0131r.
      Otomobil k\u0131smen su alt\u0131nda. Kuru k\u0131y\u0131ya do\u011Fru \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118273
    m_Localized: "K\u0131y\u0131 kayalar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118274
    m_Localized: "Otomobil yolun alt\u0131na kaym\u0131\u015F. Rampa boyunca yukar\u0131
      \xE7ek."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118275
    m_Localized: Gizli koy
    m_Metadata:
