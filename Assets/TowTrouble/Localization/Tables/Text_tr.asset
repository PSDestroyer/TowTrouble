    m_Localized: "Sahil otopark\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118298
    m_Localized: "Al\xE7ak u\xE7urum"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118299
    m_Localized: "Otomobili kurtarmadan \xF6nce devrilen a\u011Fac\u0131 kald\u0131r.
