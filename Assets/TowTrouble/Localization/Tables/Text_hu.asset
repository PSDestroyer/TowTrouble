    m_Metadata:
      m_Items: []
  - m_Id: 4730118250
    m_Localized: "Profi k\xF6t\xE9l \xB7 36 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118251
    m_Localized: "Szak\xEDt\xE1si hat\xE1r: 36 kN. Vezess \xF3vatosan. H\xFAzz egyenletesen,
