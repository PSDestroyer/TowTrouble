      m_Items: []
  - m_Id: 4730118252
    m_Localized: "Fejlesztett cs\xF6rl\u0151 \xB7 14 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118253
    m_Localized: "Cs\xF6rl\u0151er\u0151: 14 kN \xB7 Beh\xFAz\xE1si sebess\xE9g:
