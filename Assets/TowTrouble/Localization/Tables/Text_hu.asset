    m_Localized: "Sz\xFCks\xE9ges {0} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118355
    m_Localized: "V\xE9tel \xE9s felszerel\xE9s \xB7 {0} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118356
    m_Localized: "{0} \xB7 Felszerelve \xE9s mentve"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118357
    m_Localized: "Alkatr\xE9sz eladva \xB7 {0} CR \xB7 Visszat\xE9r\xEDtve"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118358
    m_Localized: "Alap {0} CR + B\xF3nuszok {1} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118359
    m_Localized: "Id\u0151: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118360
    m_Localized: "V\xE1lassz {0}?\n\nAz els\u0151 j\xE1rm\u0171ved ingyenes. K\xE9s\u0151bb
      tov\xE1bbiakat vehetsz a m\u0171helyben."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118361
    m_Localized: "{0}\n\nFeladod fizets\xE9g n\xE9lk\xFCl? A megvett felszerel\xE9s
      \xE9s a megkeresett p\xE9nz megmarad."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118362
    m_Localized: "Ir\xE1ny\xEDt\xE1s \xB7 Z\xE1rolva: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118363
    m_Localized: "Min\u0151s\xE9g: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118364
    m_Localized: "Felbont\xE1s: {0} \xD7 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118365
    m_Localized: "K\xE9p: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118366
    m_Localized: "Kamera Y tengely\xE9nek megford\xEDt\xE1sa: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118367
    m_Localized: "Cs\xF6kkentett mozg\xE1s: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118368
    m_Localized: "Fesz\xFClts\xE9gjelz\xE9sek: {0}"
    m_Metadata:
