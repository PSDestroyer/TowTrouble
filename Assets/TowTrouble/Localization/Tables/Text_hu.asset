  - m_Id: 4730118394
    m_Localized: "{0} \xB7 K\xF6t\xE9l beh\xFAz\xE1sa / K\xF6t\xE9l kienged\xE9se"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521623
    m_Localized: "Cs\xF6kkentett mozg\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521624
    m_Localized: "Fesz\xFClts\xE9gjelz\xE9sek"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521625
    m_Localized: "Oktat\xE1si tippek"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521626
    m_Localized: "Kontrollerrezg\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521627
    m_Localized: Kompatibilis
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521628
    m_Localized: "J\xE1rm\u0171"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521629
    m_Localized: "Tet\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521630
    m_Localized: Ingyenes
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521631
    m_Localized: "V\xE9tel \xE9s felszerel\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521632
    m_Localized: "Alkatr\xE9sz felszerel\xE9se"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521633
    m_Localized: Egyenleg
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521634
    m_Localized: "Els\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521635
    m_Localized: "H\xE1ts\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521636
    m_Localized: Bal
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521637
    m_Localized: Jobb
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521638
    m_Localized: "T\xF6meg"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521639
    m_Localized: "Sebess\xE9g"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521640
    m_Localized: "Tapad\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521641
    m_Localized: "Hasmagass\xE1g"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521642
    m_Localized: "Neh\xE9zs\xE9g"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521643
    m_Localized: Terep
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521644
    m_Localized: "\xDAti c\xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521645
    m_Localized: "\xC1tad\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521646
    m_Localized: "S\xFAg\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521647
    m_Localized: "Sz\xFCnet"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521648
    m_Localized: "Bet\xF6lt\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521649
    m_Localized: "Csatlakoz\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521650
    m_Localized: "V\xE9tel"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521651
    m_Localized: Folyamatban
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521652
    m_Localized: "K\xF6t\xE9l lecsatlakoztat\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715776
    m_Localized: "Korm\xE1nyz\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715777
    m_Localized: Kamera
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715778
    m_Localized: "Kamera vissza\xE1ll\xEDt\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715779
    m_Localized: "Teljes k\xE9perny\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715780
    m_Localized: "Ablakos m\xF3d"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715781
    m_Localized: Figyelem
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715782
    m_Localized: "Gyakorl\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715783
    m_Localized: "Kamera Y tengely\xE9nek megford\xEDt\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715784
    m_Localized: "Kiment\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715785
    m_Localized: "Univerz\xE1lis"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715786
    m_Localized: "Sz\xE9les homokgumi"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715787
    m_Localized: "Sz\xF6ges t\xE9li"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715788
    m_Localized: Hegyi
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715789
    m_Localized: "S\xE1rellen\xE1ll\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715790
    m_Localized: "Hasmagass\xE1g"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715791
    m_Localized: "B\xF3nuszok"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715792
    m_Localized: "A j\xE1rm\u0171ved"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715793
    m_Localized: "V\xE1lassz"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715794
    m_Localized: "J\xE1rm\u0171vek \xF6sszehasonl\xEDt\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715795
    m_Localized: "V\xE9tel \xE9s felszerel\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715796
    m_Localized: "Gyakorl\xE1s teljes\xEDtve"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715797
    m_Localized: "Ind\xEDt\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715798
    m_Localized: Feloldva
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715799
    m_Localized: "Z\xE1rolva"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715800
    m_Localized: Csapat
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715801
    m_Localized: "H\xE1zigazda"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715802
    m_Localized: "Csatlakoz\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490410
    m_Localized: "V\xE1lassz ment\xE9st, k\xE9sz\xEDtsd fel a j\xE1rm\u0171ved, \xE9s
      vidd az aut\xF3t az \xE1tad\xF3helyre."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490411
    m_Localized: "Vezess \xF3vatosan. H\xFAzz egyenletesen, \xE9s ker\xFCld a k\xF6t\xE9l
      hirtelen r\xE1nt\xE1s\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490412
    m_Localized: "T\xE1vol\xEDtsd el a kid\u0151lt f\xE1t az aut\xF3 ment\xE9se el\u0151tt."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490413
    m_Localized: "Szil\xE1rd talajr\xF3l, cs\xF6rl\u0151vel szabad\xEDtsd ki a j\xE1rm\u0171vet."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490414
    m_Localized: "Vontasd a kiszabad\xEDtott aut\xF3t a kijel\xF6lt helyre, \xE9s
      \xE1llj meg benne."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490415
    m_Localized: "V\xE1s\xE1rl\xE1s el\u0151tt n\xE9zd meg az alkatr\xE9szeket. A
      birtokolt elemek ingyen felszerelhet\u0151k."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490416
    m_Localized: "Az els\u0151 j\xE1rm\u0171ved ingyenes. K\xE9s\u0151bb tov\xE1bbiakat
      vehetsz a m\u0171helyben."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490417
    m_Localized: "A hang- \xE9s ir\xE1ny\xEDt\xE1si be\xE1ll\xEDt\xE1sok automatikusan
      ment\u0151dnek."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490418
    m_Localized: "A hanger\u0151ket k\xFCl\xF6n \xE1ll\xEDthatod. A vizu\xE1lis figyelmeztet\xE9sek
      megmaradnak."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490419
    m_Localized: "V\xE1lassz m\u0171veletet a gomb \xE1t\xE1ll\xEDt\xE1s\xE1hoz.
      Egy gombhoz csak egy m\u0171velet tartozhat."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490420
    m_Localized: "Csatlakoztass kontrollert a kioszt\xE1s megtekint\xE9s\xE9hez.
      A billenty\u0171zet \xE9s eg\xE9r tov\xE1bbra is haszn\xE1lhat\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490421
    m_Localized: "A k\xE9nyelem\xE9rt cs\xF6kkentsd a kamera \xE9s a men\xFCk mozg\xE1s\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490422
    m_Localized: "A k\xF6t\xE9lfeszess\xE9get sz\xEDnekkel \xE9s jelk\xE9pekkel is
      mutassa."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490423
    m_Localized: "A sz\xF6vegm\xE9ret \xE9s a kamera\xE9rz\xE9kenys\xE9g b\xE1rmikor
      m\xF3dos\xEDthat\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490424
    m_Localized: "Vissza\xE1ll\xEDtod a lap alap\xE9rt\xE9keit? A karrierhalad\xE1s
      megmarad."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490425
    m_Localized: "T\xF6rl\xF6d az \xF6sszes halad\xE1st? A p\xE9nz, j\xE1rm\u0171vek,
      felszerel\xE9s \xE9s \xF6ssze\xE1ll\xEDt\xE1sok t\xF6rl\u0151dnek. A be\xE1ll\xEDt\xE1sok
      megmaradnak."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490426
    m_Localized: "A halad\xE1s t\xF6rl\xE9se el\u0151tt l\xE9pj ki a j\xE1t\xE9kb\xF3l
      a f\u0151men\xFCbe."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490427
    m_Localized: "Megtartod a k\xE9pbe\xE1ll\xEDt\xE1sokat? Meger\u0151s\xEDt\xE9s
      n\xE9lk\xFCl 15 m\xE1sodperc ut\xE1n vissza\xE1llnak."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490428
    m_Localized: "Ezek az elemek nem illenek az \xFAj karossz\xE9ri\xE1hoz. A k\xE9szletedben
      maradnak."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490429
    m_Localized: "Eladod ezt az alkatr\xE9szt? Az \xFAjb\xF3li haszn\xE1lathoz ism\xE9t
      meg kell venned."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490430
    m_Localized: "A felszerelt elemeket mentsd. Az el\u0151n\xE9zetben l\xE9v\u0151
      alkatr\xE9szek nem ment\u0151dnek."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490431
    m_Localized: "Lecser\xE9led ezt az \xF6ssze\xE1ll\xEDt\xE1st a felszerelt elemekre?"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490432
    m_Localized: "Gyakorold a vezet\xE9st, k\xF6t\xE9lcsatlakoztat\xE1st, cs\xF6rl\u0151z\xE9st
      \xE9s \xE1tad\xE1st. A karriered v\xE1ltozatlan marad."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490433
    m_Localized: "A gyakorl\xE1s kihagyhat\xF3 \xE9s \xFAjraj\xE1tszhat\xF3 a J\xE1t\xE9kle\xEDr\xE1sb\xF3l."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490434
    m_Localized: "A h\xE1zigazda v\xE1laszt ment\xE9st a csapatnak."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490435
    m_Localized: "Ossz\xE1tok meg a h\xE1zigazda helyi IP-c\xEDm\xE9t a k\xF6z\xF6s
      j\xE1t\xE9khoz."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490436
    m_Localized: "A j\xE1t\xE9k indul. K\xE9rj\xFCk, v\xE1rj."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490437
    m_Localized: "A j\xE1t\xE9k nem indult el. T\xE9rj vissza a men\xFCbe, \xE9s
      pr\xF3b\xE1ld \xFAjra."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490438
    m_Localized: "Feladod fizets\xE9g n\xE9lk\xFCl? A megvett felszerel\xE9s \xE9s
      a megkeresett p\xE9nz megmarad."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490439
    m_Localized: "Haszn\xE1lj megfelel\u0151 gumikat, el\xE9g von\xF3er\u0151t \xE9s
      er\u0151s k\xF6telet."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490440
    m_Localized: "A nagyobb t\xF6meg seg\xEDti a r\xF6gz\xEDt\xE9st, de nehez\xEDti
      a vontat\xE1st emelked\u0151n."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490441
    m_Localized: "\xC1llj meg a m\u0171hely k\xF6zel\xE9ben a gar\xE1zs megnyit\xE1s\xE1hoz."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490442
    m_Localized: "Ezeket a be\xE1ll\xEDt\xE1sokat k\xE9s\u0151bb is m\xF3dos\xEDthatod."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490443
    m_Localized: "A karrierfelszerel\xE9s vissza\xE1llt. Ha k\xE9sz vagy, v\xE1lassz
      ment\xE9st."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490444
    m_Localized: "\xD3vatosan cs\xF6rl\u0151zz, a k\xF6t\xE9l az \xFAt kij\xE1rat\xE1hoz
      igazodjon."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490445
    m_Localized: "Egy ker\xE9k nyomv\xE1ly\xFAba szorult. H\xFAzz egyenletesen az
      \xFAt fel\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490446
    m_Localized: "Az alv\xE1z s\xE1rba ragadt. Szil\xE1rd talajr\xF3l h\xFAzz."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490447
    m_Localized: "Az aut\xF3 r\xE9szben v\xEDz alatt van. H\xFAzd a sz\xE1raz part
      fel\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490448
    m_Localized: "Az aut\xF3 az \xFAt al\xE1 cs\xFAszott. H\xFAzd fel a r\xE1mp\xE1n."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490449
    m_Localized: "H\xF3 vagy j\xE9g fogta be a kerekeket. A nyomok ment\xE9n h\xFAzz."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490450
    m_Localized: "A kerekek homokba s\xFCllyedtek. Szil\xE1rd talajr\xF3l h\xFAzz."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490451
    m_Localized: "A motor vagy a f\xE9k hib\xE1s. \xD3vatosan szabad\xEDtsd ki, majd
      vontasd el."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490452
    m_Localized: "Az aut\xF3 sz\xE1raz mederbe szorult. Haszn\xE1ld a kij\xE1rati
      r\xE1mp\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490453
    m_Localized: "Mentsd ki az aut\xF3t, \xE9s add \xE1t itt:"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490454
    m_Localized: "A teljes\xEDtett ment\xE9sek itt \xFAjraj\xE1tszhat\xF3k."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490455
    m_Localized: "Csak a V\xE9tel \xE9s felszerel\xE9s v\xE1laszt\xE1sakor k\xF6ltesz
      p\xE9nzt."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490456
    m_Localized: "A j\xE1rm\u0171vet birtokolnod kell az alkatr\xE9szek felszerel\xE9s\xE9hez."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490457
    m_Localized: "A karrier nem olvashat\xF3. Az eredeti ment\xE9s megmaradt."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490458
    m_Localized: "Ez a gomb a men\xFCknek vagy a kamer\xE1nak van fenntartva."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490459
    m_Localized: "Sz\xFCks\xE9ges"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490460
    m_Localized: "Felbont\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490461
    m_Localized: "Ment\xE9s f\xFCgg\u0151ben"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490462
    m_Localized: "Ment\xE9s nem el\xE9rhet\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490463
    m_Localized: "Aj\xE1nlott"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490464
    m_Localized: Alap
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490465
    m_Localized: "Els\u0151 ment\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490466
    m_Localized: "K\xF6t\xE9lszakad\xE1s n\xE9lk\xFCl"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490467
    m_Localized: "Visszat\xE9r\xEDtve"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490468
    m_Localized: "Felszerelve \xE9s mentve"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490469
    m_Localized: "Alkatr\xE9sz eladva"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490470
    m_Localized: "Szil\xE1rds\xE1g"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490471
    m_Localized: Hossz
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490472
    m_Localized: "Gumit\xEDpus"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490473
    m_Localized: "N\xE9gyker\xE9k-k\xE9szlet"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490474
    m_Localized: "Szak\xEDt\xE1si hat\xE1r"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490475
    m_Localized: "Meger\u0151s\xEDtett k\xF6t\xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490476
    m_Localized: "Profi k\xF6t\xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490477
    m_Localized: "Fejlesztett cs\xF6rl\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490478
    m_Localized: "Profi cs\xF6rl\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490479
    m_Localized: Motorszint
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490480
    m_Localized: "Neh\xE9z alpesi"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490481
    m_Localized: Motor
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490482
    m_Localized: "S\xE1rv\xE9d\u0151k"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490483
    m_Localized: Kerekek
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490484
    m_Localized: "Els\u0151 l\xF6kh\xE1r\xEDt\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490485
    m_Localized: "Tet\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490486
    m_Localized: "Sz\xEDv\xF3rendszer"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490487
    m_Localized: "Kipufog\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490488
    m_Localized: "Gy\xE1ri"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490489
    m_Localized: "Gy\xE1ri"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490490
    m_Localized: "K\xF6vetkez\u0151 lap"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490491
    m_Localized: "Kiv\xE1laszt\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490492
    m_Localized: "Navig\xE1l\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490493
    m_Localized: "Navig\xE1l\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490494
    m_Localized: "Gyors\xEDt\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490495
    m_Localized: "K\xF6t\xE9l lecsatlakoztat\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490496
    m_Localized: "Von\xF3er\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490497
    m_Localized: "Hasmagass\xE1g"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490498
    m_Localized: "H\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490499
    m_Localized: Homok
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490500
    m_Localized: "S\xE1r"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490501
    m_Localized: Legkisebb hossz
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490502
    m_Localized: Legnagyobb hossz
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490503
    m_Localized: "{0}\n\nVissza\xE1ll\xEDtod a lap alap\xE9rt\xE9keit? A karrierhalad\xE1s
      megmarad."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490504
    m_Localized: "{0}\n\nV\xE1lassz m\u0171veletet a gomb \xE1t\xE1ll\xEDt\xE1s\xE1hoz.
      Egy gombhoz csak egy m\u0171velet tartozhat."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490505
    m_Localized: "{0}\nNyomj meg egy gombot. Esc: m\xE9gse."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490506
    m_Localized: "Megtartod a k\xE9pbe\xE1ll\xEDt\xE1sokat? Meger\u0151s\xEDt\xE9s
      n\xE9lk\xFCl 15 m\xE1sodperc ut\xE1n vissza\xE1llnak.\nId\u0151: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490507
    m_Localized: "{0}\n\nLecser\xE9led ezt az \xF6ssze\xE1ll\xEDt\xE1st a felszerelt
      elemekre?\nA felszerelt elemeket mentsd. Az el\u0151n\xE9zetben l\xE9v\u0151
      alkatr\xE9szek nem ment\u0151dnek."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490508
    m_Localized: "{0} \xB7 Mentve"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490509
    m_Localized: "{0} \xB7 Felszerelve \xE9s mentve"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490510
    m_Localized: "{0} \xB7 Gy\xE1ri"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490511
    m_Localized: "Felszerelt \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490512
    m_Localized: "Mentett \xF6ssze\xE1ll\xEDt\xE1sok \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490513
    m_Localized: "\xC1tad\xE1s \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490514
    m_Localized: 'Nyelv: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490515
    m_Localized: "V\xE1lassz ment\xE9st"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490516
    m_Localized: "Elad\xE1s {0} \xB7 {1} CR?\nEladod ezt az alkatr\xE9szt? Az \xFAjb\xF3li
      haszn\xE1lathoz ism\xE9t meg kell venned."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490517
    m_Localized: "{0} \xB7 K\xF6t\xE9l beh\xFAz\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490518
    m_Localized: "{0} / {1} \xB7 Gyors\xEDt\xE1s / Tolat\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490519
    m_Localized: "{0} \xB7 Gyors\xEDt\xE1s / Tolat\xE1s\n{1} \xB7 Korm\xE1nyz\xE1s\nF\xE9k"
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144502
    m_Localized: "A Teljes\xEDtm\xE9ny cs\xF6kkenti a r\xE9szleteket. A Min\u0151s\xE9g
      t\xF6bbet tart meg. Alkalmazd az el\u0151n\xE9zethez."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144503
    m_Localized: "Megford\xEDtja a kamera f\xFCgg\u0151leges mozg\xE1s\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144504
    m_Localized: "Helyzetf\xFCgg\u0151 tippeket mutat. A c\xE9lok \xE9s k\xF6t\xE9lfigyelmeztet\xE9sek
      l\xE1that\xF3k maradnak."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144505
    m_Localized: "A tippek seg\xEDtik a tanul\xE1st. A halad\xE1s vissza\xE1ll\xEDt\xE1sa
      t\xF6rli a karriert \xE9s megtartja a be\xE1ll\xEDt\xE1sokat."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144506
    m_Localized: "A cs\xF6rl\u0151 terhel\xE9s alatt lassul, \xE9s a hat\xE1r\xE1n
      meg\xE1ll."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144507
    m_Localized: "Ez az alkatr\xE9sz csak a k\xFCls\u0151t v\xE1ltoztatja meg."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144508
    m_Localized: "Tov\xE1bbi alkatr\xE9szekhez v\xE1laszd az \xD6sszes lehet\u0151s\xE9get
      vagy m\xE1s gumit\xEDpust."
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960810
    m_Localized: "Gy\xE1ri k\xF6t\xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960811
    m_Localized: "K\xF6nny\u0171 k\xF6t\xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960812
    m_Localized: "Norm\xE1l k\xF6t\xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960813
    m_Localized: "Gy\xE1ri cs\xF6rl\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871528
    m_Localized: "Vezet\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871529
    m_Localized: "Kiegyens\xFAlyozott t\xF6meg \xE9s von\xF3er\u0151."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871530
    m_Localized: "F\xFCrge; kisebb r\xF6gz\xEDt\u0151 t\xF6meg."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871531
    m_Localized: "Jobb t\xE1masz; nehezebb emelked\u0151n."
    m_Metadata:
      m_Items: []
  - m_Id: 51321251028992
    m_Localized: "\xDAjraj\xE1tsz\xE1s \xB7 Alap {0} CR + B\xF3nuszok {1} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 51321255223296
    m_Localized: "Alap {0} CR + B\xF3nuszok {1} CR \xB7 Els\u0151 ment\xE9s +25%"
    m_Metadata:
      m_Items: []
