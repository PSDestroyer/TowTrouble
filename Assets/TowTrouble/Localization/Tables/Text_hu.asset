      m_Items: []
  - m_Id: 4730118259
    m_Localized: "M\u0171helyr\xE9t"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118260
    m_Localized: "Egy ker\xE9k nyomv\xE1ly\xFAba szorult. H\xFAzz egyenletesen az
      \xFAt fel\xE9."
