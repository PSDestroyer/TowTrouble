    m_Localized: Balans tussen massa en trekkracht.
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871530
    m_Localized: Wendbaar; minder ankergewicht.
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871531
    m_Localized: Meer houvast; zwaarder bergop.
    m_Metadata:
      m_Items: []
