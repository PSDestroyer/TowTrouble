    m_Metadata:
      m_Items: []
  - m_Id: 10548241490516
    m_Localized: "Verkopen {0} \xB7 {1} CR?\nDit onderdeel verkopen? Je moet het
      opnieuw kopen om het te gebruiken."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490517
    m_Localized: "{0} \xB7 Inhalen"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490518
