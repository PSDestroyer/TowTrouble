    m_Localized: Vindu
    m_Metadata:
      m_Items: []
  - m_Id: 4717535396
    m_Localized: "Beholde skjerminnstillingene? Uten bekreftelse g\xE5r de tilbake
      etter 15 sekunder."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535397
    m_Localized: "Oppl\xF8sning "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535398
    m_Localized: "Beholde skjerminnstillingene? Uten bekreftelse g\xE5r de tilbake
      etter 15 sekunder."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535399
    m_Localized: "Bildest\xF8rrelsen f\xF8lger konsollen din."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535400
    m_Localized: Bruk skjermendringer
    m_Metadata:
      m_Items: []
  - m_Id: 4717535401
