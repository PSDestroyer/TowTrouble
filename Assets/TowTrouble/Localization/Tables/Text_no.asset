    m_Metadata:
      m_Items: []
  - m_Id: 25606807871530
    m_Localized: Smidig; mindre vekt til forankring.
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871531
    m_Localized: Bedre fotfeste; tyngre i motbakker.
