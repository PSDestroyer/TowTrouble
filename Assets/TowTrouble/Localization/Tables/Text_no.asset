  - m_Id: 10548241490504
    m_Localized: "{0}\n\nVelg en handling for \xE5 endre tast. Hver tast kan bare
      ha \xE9n handling."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490505
    m_Localized: "{0}\nTrykk p\xE5 en tast. Esc avbryter."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490506
    m_Localized: "Beholde skjerminnstillingene? Uten bekreftelse g\xE5r de tilbake
      etter 15 sekunder.\nTid: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490507
    m_Localized: "{0}\n\nErstatte dette oppsettet med det monterte utstyret?\nLagre
      montert utstyr. Deler som bare forh\xE5ndsvises blir ikke lagret."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490508
    m_Localized: "{0} \xB7 Lagret"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490509
    m_Localized: "{0} \xB7 Montert og lagret"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490510
    m_Localized: "{0} \xB7 Standard"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490511
    m_Localized: "Monterte \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490512
    m_Localized: "Lagrede oppsett \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490513
    m_Localized: "Levering \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490514
    m_Localized: "Spr\xE5k: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490515
    m_Localized: Velg en berging
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490516
    m_Localized: "Selg {0} \xB7 {1} CR?\nSelge denne delen? Du m\xE5 kj\xF8pe den
      igjen for \xE5 bruke den."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490517
    m_Localized: "{0} \xB7 Trekk inn"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490518
    m_Localized: "{0} / {1} \xB7 Akselerer / Rygg"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490519
    m_Localized: "{0} \xB7 Akselerer / Rygg\n{1} \xB7 Styr\nBrems"
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144502
    m_Localized: "Ytelse reduserer detaljer. Kvalitet beholder flere. Bruk for \xE5
      forh\xE5ndsvise."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144503
    m_Localized: Snur den loddrette kamerabevegelsen.
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144504
    m_Localized: "Viser konteksthjelp. M\xE5l og vaiervarsler forblir synlige."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144505
    m_Localized: "Tips hjelper deg \xE5 l\xE6re. Tilbakestill fremgang sletter karrieren
      og beholder innstillinger."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144506
    m_Localized: "Vinsjen g\xE5r saktere under belastning og stopper ved grensen."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144507
    m_Localized: Denne delen endrer bare utseendet.
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144508
    m_Localized: "Velg Alle eller en annen dekktype for \xE5 se flere deler."
    m_Metadata:
      m_Items: []
