      m_Items: []
  - m_Id: 4717535402
    m_Localized: "Trykk p\xE5 en tast. Esc avbryter."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535403
    m_Localized: "Velg en handling for \xE5 endre tast. Hver tast kan bare ha \xE9n
      handling. "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535404
    m_Localized: "Velg en handling for \xE5 endre tast. Hver tast kan bare ha \xE9n
      handling."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535405
    m_Localized: 'Snu kameraets Y-akse '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535406
    m_Localized: Snur den loddrette kamerabevegelsen.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535407
    m_Localized: "Kameraf\xF8lsomhet"
    m_Metadata:
      m_Items: []
