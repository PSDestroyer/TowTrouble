      m_Items: []
  - m_Id: 4717535430
    m_Localized: TOW TROUBLE
    m_Metadata:
      m_Items: []
  - m_Id: 4717535431
    m_Localized: Du kan endre innstillingene senere.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535432
    m_Localized: "Gj\xF8r det behagelig"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535433
    m_Localized: Du kan endre innstillingene senere.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535434
    m_Localized: "Velg ditt f\xF8rste kj\xF8ret\xF8y"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535435
    m_Localized: Juster volumene hver for seg. Visuelle advarsler forblir synlige.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535436
    m_Localized: Grafikken tilpasses automatisk for denne konsollen.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535437
    m_Localized: "Beholde skjerminnstillingene? Uten bekreftelse g\xE5r de tilbake
      etter 15 sekunder."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535438
    m_Localized: "Koble til en kontroller for \xE5 se knappene. Tastatur og mus er
      fortsatt tilgjengelige."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535439
    m_Localized: "Velg en handling for \xE5 endre tast. Hver tast kan bare ha \xE9n
      handling."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535440
    m_Localized: "Tekstst\xF8rrelse og kameraf\xF8lsomhet kan endres n\xE5r som helst."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535441
    m_Localized: "Tips hjelper deg \xE5 l\xE6re. Tilbakestill fremgang sletter karrieren
      og beholder innstillinger."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535442
    m_Localized: "P\xE5"
    m_Metadata:
      m_Items: []
