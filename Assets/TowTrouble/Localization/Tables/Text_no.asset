    m_Localized: "Tekst- / HUD-st\xF8rrelse"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535409
    m_Localized: 'Redusert bevegelse '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535410
    m_Localized: Reduser kamera- og menybevegelser for bedre komfort.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535411
    m_Localized: 'Spenningssymboler '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535412
    m_Localized: Vis symboler i tillegg til farger for vaierspenning.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535413
    m_Localized: "Oppl\xE6ringstips "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535414
    m_Localized: "Viser konteksthjelp. M\xE5l og vaiervarsler forblir synlige."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535415
    m_Localized: 'Kontrollervibrasjon '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535416
    m_Localized: "Myk tilbakemelding for vaier, vinsj, st\xF8t og berginger. Kan
      sl\xE5s av n\xE5r som helst."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535417
    m_Localized: Vibrasjonsstyrke
    m_Metadata:
      m_Items: []
  - m_Id: 4717535418
    m_Localized: Slik spiller du
    m_Metadata:
      m_Items: []
  - m_Id: 4717535419
    m_Localized: "\xD8v p\xE5 kj\xF8ring, vaierfeste, vinsjing og levering. Karrieren
      p\xE5virkes ikke."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535420
    m_Localized: Nullstill fremgang
    m_Metadata:
      m_Items: []
  - m_Id: 4717535421
    m_Localized: "Slette all fremgang? Penger, kj\xF8ret\xF8y, utstyr og oppsett
      slettes. Innstillinger beholdes."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535422
    m_Localized: "Slette all fremgang? Penger, kj\xF8ret\xF8y, utstyr og oppsett
      slettes. Innstillinger beholdes."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535423
    m_Localized: "Forlat \xF8kten f\xF8r du nullstiller fremgangen."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535424
    m_Localized: Tilbakestill fanen
    m_Metadata:
      m_Items: []
  - m_Id: 4717535425
    m_Localized: 'Gjenopprett standardverdier '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535426
    m_Localized: ' Tilbakestille denne fanen? Karrierefremgangen beholdes.'
