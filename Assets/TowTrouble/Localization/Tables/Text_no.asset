    m_Localized: "Vinsjkraft: 14 kN \xB7 Inntrekkshastighet: 1.3 m/s. Vinsjen g\xE5r
      saktere under belastning og stopper ved grensen. Veigrepet begrenser brukbar
      trekkraft"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118254
    m_Localized: Karosserilakkering.
    m_Metadata:
      m_Items: []
  - m_Id: 4730118255
    m_Localized: Tunge alpindekk Hjul
    m_Metadata:
      m_Items: []
  - m_Id: 4730118256
    m_Localized: "Tunge alpindekk \xB7 Sett med fire hjul \xB7 Vei: 0% \xB7 Gj\xF8rme:
      -20% \xB7 Sand: 0% \xB7 Sn\xF8: +135% \xB7 Masse: +35 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118257
    m_Localized: "Proffvinsj \xB7 22 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118258
    m_Localized: "Vinsjkraft: 22 kN \xB7 Inntrekkshastighet: 0.85 m/s. Vinsjen g\xE5r
      saktere under belastning og stopper ved grensen. Veigrepet begrenser brukbar
      trekkraft \xB7 Anbefalt: Vaier 26 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118259
    m_Localized: Verkstedsenga
    m_Metadata:
      m_Items: []
  - m_Id: 4730118260
    m_Localized: Et hjul sitter fast i et spor. Trekk jevnt mot veien.
    m_Metadata:
      m_Items: []
  - m_Id: 4730118261
    m_Localized: Skogsspor
    m_Metadata:
      m_Items: []
  - m_Id: 4730118262
    m_Localized: "Fjern det veltede treet f\xF8r du berger bilen. Chassiset sitter
      i gj\xF8rma. Trekk fra fast underlag."
