  - m_Id: 4717535425
    m_Localized: 'Restaurar valores predeterminados '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535426
    m_Localized: " \xBFRestablecer esta pesta\xF1a? El progreso de la carrera se
      conserva."
    m_Metadata:
