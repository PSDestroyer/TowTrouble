    m_Localized: "\uC708\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535288
    m_Localized: "\uB3C4\uC0C9"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535289
    m_Localized: "\uC7A0\uAE40"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535290
    m_Localized: "\uC815\uBE44\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535291
    m_Localized: "\uC6B4\uC804, \uCF00\uC774\uBE14 \uC5F0\uACB0, \uC708\uCE58 \uC0AC\uC6A9,
      \uC778\uB3C4\uB97C \uC5F0\uC2B5\uD558\uC138\uC694. \uCEE4\uB9AC\uC5B4\uC5D0\uB294
      \uC601\uD5A5\uC744 \uC8FC\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535292
    m_Localized: "\uAD6C\uB9E4 \uC804\uC5D0 \uBD80\uD488\uC744 \uBBF8\uB9AC \uC7A5\uCC29\uD574
      \uBCF4\uC138\uC694. \uBCF4\uC720\uD55C \uBD80\uD488\uC740 \uBB34\uB8CC\uB85C
      \uC7A5\uCC29\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535293
    m_Localized: "\uAFB8\uBBF8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535294
    m_Localized: "\uAFB8\uBBF8\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535295
    m_Localized: "\uC678\uAD00"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535296
    m_Localized: "\uC131\uB2A5"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535297
    m_Localized: "\uACAC\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535298
    m_Localized: "\uAD6C\uC870"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535299
    m_Localized: "\uC815\uBE44\uC18C"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535300
    m_Localized: "\n\uCD94\uCC9C "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535301
    m_Localized: "\n\uC9C0\uD615"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535302
    m_Localized: "\uC801\uD569\uD55C \uD0C0\uC774\uC5B4, \uCDA9\uBD84\uD55C \uACAC\uC778\uB825,
      \uD2BC\uD2BC\uD55C \uCF00\uC774\uBE14\uC744 \uC0AC\uC6A9\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535303
    m_Localized: "\uCD94\uCC9C"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535304
    m_Localized: "\uC77C\uCE58\uD558\uB294 \uBD80\uD488 \uC5C6\uC74C. \uC804\uCCB4
      \uB610\uB294 \uB2E4\uB978 \uD0C0\uC774\uC5B4 \uC885\uB958\uB97C \uC120\uD0DD\uD558\uBA74
      \uB354 \uB9CE\uC740 \uBD80\uD488\uC744 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535305
    m_Localized: "\uC774 \uBD80\uD488\uC740 \uC678\uD615\uB9CC \uBC14\uAFC9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535306
    m_Localized: "\uBC14\uD034 \uB124 \uAC1C \uC138\uD2B8 \xB7 \uC9C8\uB7C9 "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535307
    m_Localized: " kg \xB7 \uC18D\uB3C4 "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535308
    m_Localized: " km/h.\n\uC9C4\uD759 \uC800\uD56D: "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535309
    m_Localized: "\xD7. Compare surface \uC811\uC9C0\uB825 below."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535310
    m_Localized: "\uBBF8\uB9AC \uBCF4\uAE30"
    m_Metadata:
      m_Items: []
