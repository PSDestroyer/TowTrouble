  - m_Id: 4730118354
    m_Localized: "\uD544\uC694 {0} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118355
    m_Localized: "\uAD6C\uB9E4 \uBC0F \uC7A5\uCC29 \xB7 {0} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118356
    m_Localized: "{0} \xB7 \uC7A5\uCC29 \uBC0F \uC800\uC7A5\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118357
    m_Localized: "\uBD80\uD488 \uD310\uB9E4\uB428 \xB7 {0} CR \xB7 \uBC18\uD658\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118358
    m_Localized: "\uAE30\uBCF8 {0} CR + \uBCF4\uB108\uC2A4 {1} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118359
    m_Localized: "\uC2DC\uAC04: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118360
    m_Localized: "\uACE0\uB974\uAE30 {0}?\n\n\uC2DC\uC791 \uCC28\uB7C9 \uD55C \uB300\uB97C
      \uBB34\uB8CC\uB85C \uC120\uD0DD\uD558\uC138\uC694. \uB2E4\uB978 \uCC28\uB7C9\uC740
      \uB098\uC911\uC5D0 \uC815\uBE44\uC18C\uC5D0\uC11C \uAD6C\uB9E4\uD560 \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118361
    m_Localized: "{0}\n\n\uBCF4\uC0C1 \uC5C6\uC774 \uC774 \uAD6C\uC870 \uC784\uBB34\uB97C
      \uB5A0\uB0A0\uAE4C\uC694? \uAD6C\uB9E4\uD55C \uC7A5\uBE44\uC640 \uD68D\uB4DD\uD55C
      \uD06C\uB808\uB527\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118362
    m_Localized: "\uC870\uC791 \xB7 \uC7A0\uAE40: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118363
    m_Localized: "\uD488\uC9C8: {0}"
    m_Metadata:
      m_Items: []
