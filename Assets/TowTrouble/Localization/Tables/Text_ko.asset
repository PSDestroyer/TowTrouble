      m_Items: []
  - m_Id: 10548241490501
    m_Localized: "\uCD5C\uC18C \uAE38\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490502
    m_Localized: "\uCD5C\uB300 \uAE38\uC774"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490503
    m_Localized: "{0}\n\n\uC774 \uD0ED\uC758 \uC124\uC815\uC744 \uCD08\uAE30\uD654\uD560\uAE4C\uC694?
      \uCEE4\uB9AC\uC5B4 \uC9C4\uD589 \uC0C1\uD669\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490504
    m_Localized: "{0}\n\n\uD0A4\uB97C \uBCC0\uACBD\uD560 \uC870\uC791\uC744 \uC120\uD0DD\uD558\uC138\uC694.
      \uAC01 \uD0A4\uC5D0\uB294 \uD55C \uAC00\uC9C0 \uB3D9\uC791\uB9CC \uC9C0\uC815\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490505
    m_Localized: "{0}\n\uD0A4\uB97C \uB204\uB974\uC138\uC694. Esc\uB85C \uCDE8\uC18C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490506
    m_Localized: "\uD654\uBA74 \uC124\uC815\uC744 \uC720\uC9C0\uD560\uAE4C\uC694?
      \uD655\uC778\uD558\uC9C0 \uC54A\uC73C\uBA74 15\uCD08 \uD6C4 \uC774\uC804 \uC124\uC815\uC73C\uB85C
      \uB3CC\uC544\uAC11\uB2C8\uB2E4.\n\uC2DC\uAC04: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490507
    m_Localized: "{0}\n\n\uC800\uC7A5\uB41C \uAD6C\uC131\uC744 \uD604\uC7AC \uC7A5\uCC29
      \uC911\uC778 \uC7A5\uBE44\uB85C \uB36E\uC5B4\uC4F8\uAE4C\uC694?\n\uC7A5\uCC29
      \uC911\uC778 \uC7A5\uBE44\uB97C \uC800\uC7A5\uD569\uB2C8\uB2E4. \uBBF8\uB9AC
      \uBCF4\uAE30 \uC911\uC778 \uBD80\uD488\uC740 \uC800\uC7A5\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490508
    m_Localized: "{0} \xB7 \uC800\uC7A5\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490509
    m_Localized: "{0} \xB7 \uC7A5\uCC29 \uBC0F \uC800\uC7A5\uB428"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490510
    m_Localized: "{0} \xB7 \uC21C\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490511
    m_Localized: "\uC7A5\uCC29 \uC911 \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490512
    m_Localized: "\uC800\uC7A5\uB41C \uAD6C\uC131 \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490513
    m_Localized: "\uC778\uB3C4 \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490514
    m_Localized: "\uC5B8\uC5B4: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490515
    m_Localized: "\uAD6C\uC870 \uC784\uBB34\uB97C \uC120\uD0DD\uD558\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490516
    m_Localized: "\uD310\uB9E4 {0} \xB7 {1} CR?\n\uC774 \uBD80\uD488\uC744 \uD310\uB9E4\uD560\uAE4C\uC694?
      \uB2E4\uC2DC \uC0AC\uC6A9\uD558\uB824\uBA74 \uC7AC\uAD6C\uB9E4\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490517
    m_Localized: "{0} \xB7 \uAC10\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490518
    m_Localized: "{0} / {1} \xB7 \uAC00\uC18D / \uD6C4\uC9C4"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490519
    m_Localized: "{0} \xB7 \uAC00\uC18D / \uD6C4\uC9C4\n{1} \xB7 \uC870\uD5A5\n\uBE0C\uB808\uC774\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144502
    m_Localized: "\uC131\uB2A5\uC740 \uC138\uBD80 \uBB18\uC0AC\uB97C \uC904\uC774\uACE0
      \uD488\uC9C8\uC740 \uB354 \uB9CE\uC740 \uB514\uD14C\uC77C\uC744 \uC720\uC9C0\uD569\uB2C8\uB2E4.
      \uC801\uC6A9\uD574 \uD655\uC778\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144503
    m_Localized: "\uCE74\uBA54\uB77C\uC758 \uC218\uC9C1 \uC774\uB3D9 \uBC29\uD5A5\uC744
      \uBC18\uC804\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144504
    m_Localized: "\uC0C1\uD669\uBCC4 \uB3C4\uC6C0\uB9D0\uC744 \uD45C\uC2DC\uD569\uB2C8\uB2E4.
      \uBAA9\uD45C\uC640 \uCF00\uC774\uBE14 \uACBD\uACE0\uB294 \uACC4\uC18D \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144505
    m_Localized: "\uB3C4\uC6C0\uB9D0\uC740 \uD559\uC2B5\uC744 \uB3D5\uC2B5\uB2C8\uB2E4.
      \uC9C4\uD589 \uCD08\uAE30\uD654\uB294 \uCEE4\uB9AC\uC5B4\uB97C \uC9C0\uC6B0\uACE0
      \uD658\uACBD \uC124\uC815\uC740 \uC720\uC9C0\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144506
    m_Localized: "\uC708\uCE58\uB294 \uD558\uC911\uC774 \uCEE4\uC9C0\uBA74 \uB290\uB824\uC9C0\uACE0
      \uD55C\uACC4\uC5D0\uC11C \uBA48\uCDA5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144507
    m_Localized: "\uC774 \uBD80\uD488\uC740 \uC678\uD615\uB9CC \uBC14\uAFC9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144508
    m_Localized: "\uC804\uCCB4 \uB610\uB294 \uB2E4\uB978 \uD0C0\uC774\uC5B4 \uC885\uB958\uB97C
      \uC120\uD0DD\uD558\uBA74 \uB354 \uB9CE\uC740 \uBD80\uD488\uC744 \uBCFC \uC218
      \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960810
    m_Localized: "\uAE30\uBCF8 \uCF00\uC774\uBE14"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960811
    m_Localized: "\uACBD\uB7C9 \uCF00\uC774\uBE14"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960812
    m_Localized: "\uD45C\uC900 \uCF00\uC774\uBE14"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960813
    m_Localized: "\uAE30\uBCF8 \uC708\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871528
    m_Localized: "\uC6B4\uC804"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871529
    m_Localized: "\uC9C8\uB7C9\uACFC \uACAC\uC778\uB825\uC758 \uADE0\uD615\uC774
      \uC88B\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871530
    m_Localized: "\uBBFC\uCCA9\uD558\uC9C0\uB9CC \uACE0\uC815\uC5D0 \uC4F8 \uBB34\uAC8C\uAC00
      \uC801\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871531
    m_Localized: "\uC9C0\uC9C0\uB825\uC774 \uC88B\uC9C0\uB9CC \uC624\uB974\uB9C9\uC5D0\uC11C
      \uBB34\uAC81\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 51321251028992
    m_Localized: "\uB2E4\uC2DC \uD50C\uB808\uC774 \xB7 \uAE30\uBCF8 {0} CR + \uBCF4\uB108\uC2A4
      {1} CR"
    m_Metadata:
      m_Items: []
  - m_Id: 51321255223296
    m_Localized: "\uAE30\uBCF8 {0} CR + \uBCF4\uB108\uC2A4 {1} CR \xB7 \uCCAB \uAD6C\uC870
      +25%"
