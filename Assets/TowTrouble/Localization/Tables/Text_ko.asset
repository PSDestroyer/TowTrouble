      m_Items: []
  - m_Id: 4717535371
    m_Localized: "\uC9C4\uD589 \uC911\uC778 \uAD6C\uC870 \uC784\uBB34\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC74C \uBAA9\uC801\uC9C0\uB97C \uC120\uD0DD\uD558\uC138\uC694."
