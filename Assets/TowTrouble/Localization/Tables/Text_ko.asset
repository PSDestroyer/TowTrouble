      m_Items: []
  - m_Id: 4717535374
    m_Localized: "\uD638\uC2A4\uD2B8\uAC00 \uD300\uC758 \uAD6C\uC870 \uC784\uBB34\uB97C
      \uC120\uD0DD\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
