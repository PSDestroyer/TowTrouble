    m_Localized: "Retours discrets pour le c\xE2ble, le treuil, les chocs et les
      d\xE9pannages. D\xE9sactivables \xE0 tout moment."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535417
    m_Localized: "Intensit\xE9 des vibrations"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535418
