    m_Localized: "\u0412\u0441\u044A\u0434\u0435\u0445\u043E\u0434\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118233
    m_Localized: "\u0412\u0441\u044A\u0434\u0435\u0445\u043E\u0434\u043D\u0438 \xB7
      \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u043E\u0442 \u0447\u0435\u0442\u0438\u0440\u0438
      \u043A\u043E\u043B\u0435\u043B\u0430 \xB7 \u041F\u044A\u0442: 0% \xB7 \u041A\u0430\u043B:
      +10% \xB7 \u041F\u044F\u0441\u044A\u043A: 0% \xB7 \u0421\u043D\u044F\u0433:
      0% \xB7 \u041C\u0430\u0441\u0430: 0 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118234
    m_Localized: "\u041A\u0430\u043B\u043D\u0438 \u0433\u0443\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118235
    m_Localized: "\u041A\u0430\u043B \xB7 \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442
      \u043E\u0442 \u0447\u0435\u0442\u0438\u0440\u0438 \u043A\u043E\u043B\u0435\u043B\u0430
      \xB7 \u041F\u044A\u0442: 0% \xB7 \u041A\u0430\u043B: +30% \xB7 \u041F\u044F\u0441\u044A\u043A:
      0% \xB7 \u0421\u043D\u044F\u0433: 0% \xB7 \u041C\u0430\u0441\u0430: 0 kg \xB7
      \u0421\u044A\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
      \u0432 \u043A\u0430\u043B: -15%"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118236
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0438 \u043F\u044F\u0441\u044A\u0447\u043D\u0438
      \u0433\u0443\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118237
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0438 \u0437\u0430 \u043F\u044F\u0441\u044A\u043A
      \xB7 \u041A\u043E\u043C\u043F\u043B\u0435\u043A\u0442 \u043E\u0442 \u0447\u0435\u0442\u0438\u0440\u0438
      \u043A\u043E\u043B\u0435\u043B\u0430 \xB7 \u041F\u044A\u0442: 0% \xB7 \u041A\u0430\u043B:
      -10% \xB7 \u041F\u044F\u0441\u044A\u043A: +45% \xB7 \u0421\u043D\u044F\u0433:
      0% \xB7 \u041C\u0430\u0441\u0430: 0 kg"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118238
    m_Localized: "\u0417\u0438\u043C\u043D\u0438 \u0433\u0443\u043C\u0438 \u0441
      \u0448\u0438\u043F\u043E\u0432\u0435"
    m_Metadata:
      m_Items: []
