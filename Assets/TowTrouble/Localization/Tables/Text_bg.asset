    m_Metadata:
      m_Items: []
  - m_Id: 4730118359
    m_Localized: "\u0412\u0440\u0435\u043C\u0435: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118360
    m_Localized: "\u0418\u0437\u0431\u0435\u0440\u0438 {0}?\n\n\u0418\u0437\u0431\u0435\u0440\u0438
      \u043F\u044A\u0440\u0432\u0438\u044F \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B
      \u0431\u0435\u0437\u043F\u043B\u0430\u0442\u043D\u043E. \u0414\u0440\u0443\u0433\u0438
      \u0441\u0435 \u043A\u0443\u043F\u0443\u0432\u0430\u0442 \u043F\u043E-\u043A\u044A\u0441\u043D\u043E
      \u0432 \u0440\u0430\u0431\u043E\u0442\u0438\u043B\u043D\u0438\u0446\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 4730118361
    m_Localized: "{0}\n\n\u041E\u0442\u043A\u0430\u0437 \u0431\u0435\u0437 \u0437\u0430\u043F\u043B\u0430\u0449\u0430\u043D\u0435?
