    m_Metadata:
      m_Items: []
  - m_Id: 4721729686
    m_Localized: Open the workshop yard for your crew. Share your computer's local
      IP address with your friend.
    m_Metadata:
      m_Items: []
  - m_Id: 4721729687
    m_Localized: "Direct IP / LAN \xB7 UDP 7777 \xB7 2 players"
    m_Metadata:
      m_Items: []
  - m_Id: 4721729688
