  - m_Id: 10548241490499
    m_Localized: Hiekka
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490500
    m_Localized: Muta
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490501
    m_Localized: "V\xE4himm\xE4ispituus"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490502
    m_Localized: "Enimm\xE4ispituus"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490503
    m_Localized: "{0}\n\nPalautetaanko t\xE4m\xE4n v\xE4lilehden oletukset? Uran
      edistyminen s\xE4ilyy."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490504
    m_Localized: "{0}\n\nValitse ohjaus muuttaaksesi n\xE4pp\xE4int\xE4. Yhdell\xE4
      n\xE4pp\xE4imell\xE4 voi olla vain yksi toiminto."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490505
    m_Localized: "{0}\nPaina n\xE4pp\xE4int\xE4. Esc peruuttaa."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490506
    m_Localized: "S\xE4ilytet\xE4\xE4nk\xF6 n\xE4ytt\xF6asetukset? Ilman vahvistusta
      ne palautuvat 15 sekunnissa.\nAika: {0} s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490507
    m_Localized: "{0}\n\nKorvataanko t\xE4m\xE4 kokoonpano asennetulla varustuksella?\nTallenna
      asennettu varustus. Esikatselun osia ei tallenneta."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490508
    m_Localized: "{0} \xB7 Tallennettu"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490509
    m_Localized: "{0} \xB7 Asennettu ja tallennettu"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490510
    m_Localized: "{0} \xB7 Vakio"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490511
    m_Localized: "Asennetut \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490512
    m_Localized: "Tallennetut kokoonpanot \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490513
    m_Localized: "Toimitus \xB7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490514
    m_Localized: 'Kieli: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490515
    m_Localized: Valitse pelastus
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490516
    m_Localized: "Myy {0} \xB7 {1} CR?\nMyyd\xE4\xE4nk\xF6 t\xE4m\xE4 osa? Se on
      ostettava uudelleen ennen k\xE4ytt\xF6\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490517
    m_Localized: "{0} \xB7 Kelaa sis\xE4\xE4n"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490518
    m_Localized: "{0} / {1} \xB7 Kiihdyt\xE4 / Peruuta"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490519
    m_Localized: "{0} \xB7 Kiihdyt\xE4 / Peruuta\n{1} \xB7 Ohjaa\nJarru"
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144502
    m_Localized: "Suorituskyky v\xE4hent\xE4\xE4 yksityiskohtia. Laatu s\xE4ilytt\xE4\xE4
      enemm\xE4n. K\xE4yt\xE4 esikatselua varten."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144503
    m_Localized: "K\xE4\xE4nt\xE4\xE4 kameran pystysuuntaisen liikkeen."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144504
    m_Localized: "N\xE4ytt\xE4\xE4 tilannekohtaiset vihjeet. Tavoitteet ja vaijerivaroitukset
      pysyv\xE4t n\xE4kyviss\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144505
    m_Localized: "Vihjeet auttavat oppimaan. Edistymisen nollaus poistaa uran ja
      s\xE4ilytt\xE4\xE4 asetukset."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144506
    m_Localized: "Vinssi hidastuu kuormituksessa ja pys\xE4htyy rajallaan."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144507
    m_Localized: "T\xE4m\xE4 osa muuttaa vain ulkon\xE4k\xF6\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144508
    m_Localized: "Valitse Kaikki tai toinen rengastyyppi n\xE4hd\xE4ksesi lis\xE4\xE4
      osia."
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960810
    m_Localized: "Alkuper\xE4inen vaijeri"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960811
    m_Localized: Kevyt vaijeri
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960812
    m_Localized: Vakiovaijeri
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960813
    m_Localized: "Alkuper\xE4inen vinssi"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871528
    m_Localized: Aja
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871529
    m_Localized: "Tasapaino massan ja vetovoiman v\xE4lill\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871530
    m_Localized: "Ketter\xE4; v\xE4hemm\xE4n ankkuroivaa painoa."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871531
    m_Localized: "Parempi tuki; raskaampi yl\xE4m\xE4ess\xE4."
    m_Metadata:
      m_Items: []
