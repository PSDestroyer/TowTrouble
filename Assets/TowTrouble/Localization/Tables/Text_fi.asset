    m_Metadata:
      m_Items: []
  - m_Id: 4717535429
    m_Localized: "Seuraava v\xE4lilehti"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535430
    m_Localized: TOW TROUBLE
    m_Metadata:
      m_Items: []
  - m_Id: 4717535431
    m_Localized: "Voit muuttaa asetuksia my\xF6hemmin."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535432
    m_Localized: "S\xE4\xE4d\xE4 mukavaksi"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535433
    m_Localized: "Voit muuttaa asetuksia my\xF6hemmin."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535434
    m_Localized: "Valitse ensimm\xE4inen ajoneuvosi"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535435
    m_Localized: "S\xE4\xE4d\xE4 \xE4\xE4nenvoimakkuuksia erikseen. N\xE4kyv\xE4t
      varoitukset s\xE4ilyv\xE4t."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535436
    m_Localized: "Grafiikka mukautetaan automaattisesti t\xE4lle konsolille."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535437
    m_Localized: "S\xE4ilytet\xE4\xE4nk\xF6 n\xE4ytt\xF6asetukset? Ilman vahvistusta
      ne palautuvat 15 sekunnissa."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535438
    m_Localized: "Liit\xE4 ohjain n\xE4hd\xE4ksesi sen painikkeet. N\xE4pp\xE4imist\xF6
      ja hiiri ovat yh\xE4 k\xE4ytett\xE4viss\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535439
    m_Localized: "Valitse ohjaus muuttaaksesi n\xE4pp\xE4int\xE4. Yhdell\xE4 n\xE4pp\xE4imell\xE4
      voi olla vain yksi toiminto."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535440
    m_Localized: "Tekstin kokoa ja kameran herkkyytt\xE4 voi muuttaa milloin tahansa."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535441
    m_Localized: "Vihjeet auttavat oppimaan. Edistymisen nollaus poistaa uran ja
      s\xE4ilytt\xE4\xE4 asetukset."
