  - m_Id: 4717535412
    m_Localized: "N\xE4yt\xE4 vaijerin j\xE4nnityksess\xE4 symbolit v\xE4rien lis\xE4ksi."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535413
    m_Localized: 'Opastusvihjeet '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535414
    m_Localized: "N\xE4ytt\xE4\xE4 tilannekohtaiset vihjeet. Tavoitteet ja vaijerivaroitukset
      pysyv\xE4t n\xE4kyviss\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535415
    m_Localized: "Ohjaimen v\xE4rin\xE4 "
    m_Metadata:
      m_Items: []
  - m_Id: 4717535416
    m_Localized: "Kevyt palaute vaijerista, vinssist\xE4, iskuista ja pelastuksista.
      Voi poistaa k\xE4yt\xF6st\xE4 milloin vain."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535417
    m_Localized: "V\xE4rin\xE4n voimakkuus"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535418
    m_Localized: Peliohjeet
    m_Metadata:
      m_Items: []
  - m_Id: 4717535419
    m_Localized: "Harjoittele ajamista, vaijerin kiinnityst\xE4, vinssausta ja toimitusta.
      Urasi s\xE4ilyy ennallaan."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535420
    m_Localized: Nollaa edistyminen
    m_Metadata:
      m_Items: []
  - m_Id: 4717535421
    m_Localized: "Poistetaanko kaikki edistyminen? Rahat, ajoneuvot, varusteet ja
      kokoonpanot poistuvat. Asetukset s\xE4ilyv\xE4t."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535422
    m_Localized: "Poistetaanko kaikki edistyminen? Rahat, ajoneuvot, varusteet ja
      kokoonpanot poistuvat. Asetukset s\xE4ilyv\xE4t."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535423
    m_Localized: Poistu istunnosta ennen edistymisen nollaamista.
    m_Metadata:
      m_Items: []
  - m_Id: 4717535424
    m_Localized: "Palauta v\xE4lilehden oletukset"
    m_Metadata:
      m_Items: []
  - m_Id: 4717535425
    m_Localized: 'Palauta oletukset '
    m_Metadata:
      m_Items: []
  - m_Id: 4717535426
    m_Localized: " Palautetaanko t\xE4m\xE4n v\xE4lilehden oletukset? Uran edistyminen
      s\xE4ilyy."
    m_Metadata:
      m_Items: []
  - m_Id: 4717535427
    m_Localized: Palauta oletukset
    m_Metadata:
      m_Items: []
  - m_Id: 4717535428
