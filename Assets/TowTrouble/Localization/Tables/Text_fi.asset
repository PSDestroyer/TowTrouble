    m_Metadata:
      m_Items: []
  - m_Id: 3520844521642
    m_Localized: Vaikeus
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521643
    m_Localized: Maasto
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521644
    m_Localized: Kohde
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521645
    m_Localized: Toimitus
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521646
    m_Localized: Ohje
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521647
    m_Localized: Tauko
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521648
    m_Localized: Ladataan
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521649
    m_Localized: "Yhdistet\xE4\xE4n"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521650
    m_Localized: Osta
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521651
    m_Localized: "K\xE4ynniss\xE4"
    m_Metadata:
      m_Items: []
  - m_Id: 3520844521652
    m_Localized: Irrota vaijeri
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715776
    m_Localized: Ohjaa
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715777
    m_Localized: Kamera
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715778
    m_Localized: Palauta kamera
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715779
    m_Localized: "Koko n\xE4ytt\xF6"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715780
    m_Localized: Ikkuna
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715781
    m_Localized: Varoitus
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715782
    m_Localized: Harjoittelu
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715783
    m_Localized: "K\xE4\xE4nn\xE4 kameran Y-akseli"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715784
    m_Localized: Pelasta
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715785
    m_Localized: Yleis
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715786
    m_Localized: "Leve\xE4 hiekka"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715787
    m_Localized: Nastatalvi
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715788
    m_Localized: Vuoristo
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715789
    m_Localized: Mutavastus
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715790
    m_Localized: Maavara
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715791
    m_Localized: Bonukset
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715792
    m_Localized: Ajoneuvosi
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715793
    m_Localized: Valitse
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715794
    m_Localized: Vertaa ajoneuvoja
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715795
    m_Localized: Osta ja asenna
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715796
    m_Localized: Harjoittelu suoritettu
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715797
    m_Localized: Aloita
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715798
    m_Localized: Avattu
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715799
    m_Localized: Lukittu
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715800
    m_Localized: "Ryhm\xE4"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715801
    m_Localized: "Is\xE4nt\xE4"
    m_Metadata:
      m_Items: []
  - m_Id: 3520848715802
    m_Localized: Liity
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490410
    m_Localized: "Valitse pelastusteht\xE4v\xE4, valmistele ajoneuvosi ja toimita
      auto perille."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490411
    m_Localized: "Aja rauhallisesti. Ved\xE4 tasaisesti ja v\xE4lt\xE4 vaijerin nyk\xE4isyj\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490412
    m_Localized: Poista kaatunut puu ennen auton pelastamista.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490413
    m_Localized: "Vapauta ajoneuvo vinssill\xE4 kiinte\xE4lt\xE4 maalta."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490414
    m_Localized: "Hinaa vapautettu auto merkittyyn toimitusalueeseen ja pys\xE4hdy
      sen sis\xE4\xE4n."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490415
    m_Localized: Esikatsele osia ennen ostoa. Omistamasi osat asennetaan ilmaiseksi.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490416
    m_Localized: "Valitse ensimm\xE4inen ajoneuvo ilmaiseksi. Muut ostetaan my\xF6hemmin
      korjaamolta."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490417
    m_Localized: "\xC4\xE4ni- ja ohjausasetukset tallentuvat automaattisesti."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490418
    m_Localized: "S\xE4\xE4d\xE4 \xE4\xE4nenvoimakkuuksia erikseen. N\xE4kyv\xE4t
      varoitukset s\xE4ilyv\xE4t."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490419
    m_Localized: "Valitse ohjaus muuttaaksesi n\xE4pp\xE4int\xE4. Yhdell\xE4 n\xE4pp\xE4imell\xE4
      voi olla vain yksi toiminto."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490420
    m_Localized: "Liit\xE4 ohjain n\xE4hd\xE4ksesi sen painikkeet. N\xE4pp\xE4imist\xF6
      ja hiiri ovat yh\xE4 k\xE4ytett\xE4viss\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490421
    m_Localized: "V\xE4henn\xE4 kameran ja valikoiden liikett\xE4 mukavuuden vuoksi."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490422
    m_Localized: "N\xE4yt\xE4 vaijerin j\xE4nnityksess\xE4 symbolit v\xE4rien lis\xE4ksi."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490423
    m_Localized: "Tekstin kokoa ja kameran herkkyytt\xE4 voi muuttaa milloin tahansa."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490424
    m_Localized: "Palautetaanko t\xE4m\xE4n v\xE4lilehden oletukset? Uran edistyminen
      s\xE4ilyy."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490425
    m_Localized: "Poistetaanko kaikki edistyminen? Rahat, ajoneuvot, varusteet ja
      kokoonpanot poistuvat. Asetukset s\xE4ilyv\xE4t."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490426
    m_Localized: Poistu istunnosta ennen edistymisen nollaamista.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490427
    m_Localized: "S\xE4ilytet\xE4\xE4nk\xF6 n\xE4ytt\xF6asetukset? Ilman vahvistusta
      ne palautuvat 15 sekunnissa."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490428
    m_Localized: "N\xE4m\xE4 osat eiv\xE4t sovi uuteen koriin. Ne j\xE4\xE4v\xE4t
      varastoosi."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490429
    m_Localized: "Myyd\xE4\xE4nk\xF6 t\xE4m\xE4 osa? Se on ostettava uudelleen ennen
      k\xE4ytt\xF6\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490430
    m_Localized: Tallenna asennettu varustus. Esikatselun osia ei tallenneta.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490431
    m_Localized: "Korvataanko t\xE4m\xE4 kokoonpano asennetulla varustuksella?"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490432
    m_Localized: "Harjoittele ajamista, vaijerin kiinnityst\xE4, vinssausta ja toimitusta.
      Urasi s\xE4ilyy ennallaan."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490433
    m_Localized: Harjoittelun voi ohittaa ja toistaa Peliohjeista.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490434
    m_Localized: "Is\xE4nt\xE4 valitsee ryhm\xE4n pelastusteht\xE4v\xE4n."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490435
    m_Localized: "Jakakaa is\xE4nn\xE4n paikallinen IP-osoite pelataksenne yhdess\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490436
    m_Localized: "Peli k\xE4ynnistyy. Odota hetki."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490437
    m_Localized: "Peli ei k\xE4ynnistynyt. Palaa valikkoon ja yrit\xE4 uudelleen."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490438
    m_Localized: "Hyl\xE4t\xE4\xE4nk\xF6 teht\xE4v\xE4 ilman maksua? Ostetut varusteet
      ja ansaitut rahat s\xE4ilyv\xE4t."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490439
    m_Localized: "K\xE4yt\xE4 sopivia renkaita, riitt\xE4v\xE4\xE4 vetovoimaa ja
      vahvaa vaijeria."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490440
    m_Localized: "Suurempi massa auttaa ankkuroinnissa mutta vaikeuttaa hinausta
      yl\xE4m\xE4ess\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490441
    m_Localized: "Pys\xE4hdy korjaamon l\xE4helle avataksesi autotallin."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490442
    m_Localized: "Voit muuttaa asetuksia my\xF6hemmin."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490443
    m_Localized: "Uran varustus on palautettu. Valitse pelastusteht\xE4v\xE4, kun
      olet valmis."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490444
    m_Localized: "Vinssaa varovasti ja suuntaa vaijeri poistumistiet\xE4 kohti."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490445
    m_Localized: "Py\xF6r\xE4 on juuttunut uraan. Ved\xE4 tasaisesti tiet\xE4 kohti."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490446
    m_Localized: "Alusta on juuttunut mutaan. Ved\xE4 kiinte\xE4lt\xE4 maalta."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490447
    m_Localized: "Auto on osittain veden alla. Ved\xE4 kuivaa rantaa kohti."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490448
    m_Localized: "Auto on liukunut tien alapuolelle. Ved\xE4 se ramppia pitkin yl\xF6s."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490449
    m_Localized: "Lumi tai j\xE4\xE4 on vanginnut py\xF6r\xE4t. Ved\xE4 j\xE4lkien
      suuntaisesti."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490450
    m_Localized: "Py\xF6r\xE4t ovat hautautuneet hiekkaan. Ved\xE4 kiinte\xE4lt\xE4
      maalta."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490451
    m_Localized: Moottori tai jarrut ovat rikki. Vapauta auto varovasti ja hinaa
      se.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490452
    m_Localized: "Auto on juuttunut kuivaan uomaan. K\xE4yt\xE4 poistumisramppia."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490453
    m_Localized: Pelasta auto ja toimita se kohteeseen
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490454
    m_Localized: "Suoritetut pelastukset ilmestyv\xE4t t\xE4nne uusintaa varten."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490455
    m_Localized: Rahaa kuluu vasta, kun valitset Osta ja asenna.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490456
    m_Localized: Ajoneuvo on omistettava ennen osien asentamista.
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490457
    m_Localized: "Uraa ei voitu lukea. Alkuper\xE4inen tallennus on s\xE4ilytetty."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490458
    m_Localized: "T\xE4m\xE4 n\xE4pp\xE4in on varattu valikoille tai kameralle."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490459
    m_Localized: Tarvitaan
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490460
    m_Localized: Tarkkuus
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490461
    m_Localized: Tallennus odottaa
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490462
    m_Localized: "Tallennus ei k\xE4ytett\xE4viss\xE4"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490463
    m_Localized: Suositeltu
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490464
    m_Localized: Perussumma
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490465
    m_Localized: "Ensimm\xE4inen pelastus"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490466
    m_Localized: Ei vaijerin katkeamisia
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490467
    m_Localized: Palautettu
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490468
    m_Localized: Asennettu ja tallennettu
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490469
    m_Localized: Osa myyty
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490470
    m_Localized: Lujuus
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490471
    m_Localized: Pituus
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490472
    m_Localized: Rengastyyppi
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490473
    m_Localized: "Nelj\xE4n py\xF6r\xE4n sarja"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490474
    m_Localized: Murtoraja
    m_Metadata:
      m_Items: []
