  - m_Id: 4730118372
    m_Localized: "{0} \xB7 Autotalli"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118373
    m_Localized: "{0} \xB7 Open the Korjaamo"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118374
    m_Localized: "{0} \xB7 Attach your Vaijeri"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118375
    m_Localized: "{0} to Kelaa sis\xE4\xE4n, then Vetovoima the car Ilmainen"
