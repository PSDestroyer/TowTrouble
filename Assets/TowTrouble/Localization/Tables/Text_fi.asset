    m_Metadata:
      m_Items: []
  - m_Id: 4730118247
    m_Localized: "Maavara +15 cm \xB7 Maastojousitus"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118248
    m_Localized: "Vahvistettu vaijeri \xB7 26 kN"
    m_Metadata:
      m_Items: []
  - m_Id: 4730118249
    m_Localized: "Murtoraja: 26 kN. Aja rauhallisesti. Ved\xE4 tasaisesti ja v\xE4lt\xE4
