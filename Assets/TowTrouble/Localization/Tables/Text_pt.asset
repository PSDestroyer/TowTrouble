    m_Metadata:
      m_Items: []
  - m_Id: 10548241490514
    m_Localized: 'Idioma: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490515
    m_Localized: Escolha um resgate
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490516
    m_Localized: "Vender {0} \xB7 {1} CR?\nVender esta pe\xE7a? Ter\xE1s de a comprar
      novamente para a utilizar."
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490517
    m_Localized: "{0} \xB7 Recolher cabo"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490518
    m_Localized: "{0} / {1} \xB7 Acelerar / Marcha-atr\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 10548241490519
    m_Localized: "{0} \xB7 Acelerar / Marcha-atr\xE1s\n{1} \xB7 Virar\nTrav\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144502
    m_Localized: "Desempenho reduz os detalhes. Qualidade mant\xE9m mais. Aplique
      para ver a pr\xE9via."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144503
    m_Localized: "Inverte o movimento vertical da c\xE2mera."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144504
    m_Localized: "Mostra dicas contextuais. Objetivos e alertas do cabo continuam
      vis\xEDveis."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144505
    m_Localized: "As dicas ajudam a aprender. Redefinir progresso apaga a carreira
      e mant\xE9m as prefer\xEAncias."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144506
    m_Localized: O guincho perde velocidade sob carga e para no limite.
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144507
    m_Localized: "Esta pe\xE7a s\xF3 muda a apar\xEAncia."
    m_Metadata:
      m_Items: []
  - m_Id: 14491554144508
    m_Localized: "Escolha Todos ou outro tipo de pneus para ver mais pe\xE7as."
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960810
    m_Localized: "Cabo de f\xE1brica"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960811
    m_Localized: Cabo leve
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960812
    m_Localized: "Cabo padr\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 16314620960813
    m_Localized: "Guincho de f\xE1brica"
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871528
    m_Localized: Conduzir
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871529
    m_Localized: "Equil\xEDbrio entre massa e tra\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871530
    m_Localized: "\xC1gil; menos peso para ancoragem."
    m_Metadata:
      m_Items: []
  - m_Id: 25606807871531
    m_Localized: Melhor apoio; mais pesado nas subidas.
    m_Metadata:
      m_Items: []
